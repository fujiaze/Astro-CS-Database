{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACR Route Profile",
  "description": "ACR 静态路由档案（routes.json）。Phase E qualification 生成，routing 模块只读消费。",
  "type": "object",
  "required": ["schema_version", "generated_at", "profile_kind", "fingerprint", "routes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "acr.route_profile.v1",
      "description": "Schema 版本（routing 解析器据此识别 corrupt）"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z$",
      "description": "生成时间戳 ISO 8601 简化格式 YYYYMMDDTHHMMSSZ"
    },
    "profile_kind": {
      "type": "string",
      "enum": ["quick", "standard", "full"],
      "description": "标定档位"
    },
    "fingerprint": {
      "$ref": "#/definitions/DeviceFingerprint"
    },
    "routes": {
      "type": "array",
      "items": {"$ref": "#/definitions/RouteEntry"},
      "minItems": 0
    },
    "raw_results": {
      "type": "array",
      "items": {"$ref": "#/definitions/KernelBenchmarkResult"},
      "description": "原始 benchmark 样本（仅 full profile 输出）"
    }
  },
  "definitions": {
    "DeviceFingerprint": {
      "type": "object",
      "required": ["cpu_model", "cpu_cores", "isa_mask", "gpu_name", "gpu_memory_bytes", "gpu_driver_version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "cpu_model":         {"type": "string"},
        "cpu_cores":         {"type": "integer", "minimum": 1},
        "isa_mask":          {"type": "integer", "minimum": 0},
        "gpu_name":          {"type": "string"},
        "gpu_memory_bytes":  {"type": "integer", "minimum": 0},
        "gpu_driver_version":{"type": "string"},
        "sha256":            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "RouteEntry": {
      "type": "object",
      "required": ["kernel_id", "kernel_name", "precision", "preferred_backend", "expected_throughput_gbps", "reason"],
      "additionalProperties": false,
      "properties": {
        "kernel_id":                 {"type": "integer", "minimum": 0},
        "kernel_name":               {"type": "string"},
        "precision":                 {"type": "string", "enum": ["fp32", "fp64", "int"]},
        "preferred_backend":         {"type": "string", "pattern": "^(cpu|cuda:[0-9]+)$"},
        "expected_throughput_gbps":  {"type": "number", "minimum": 0},
        "reason":                    {"type": "string", "enum": ["fastest", "only-avail", "cpu-baseline"]}
      }
    },
    "KernelBenchmarkResult": {
      "type": "object",
      "required": ["kernel_id", "kernel_name", "backend", "precision", "problem_size", "bytes_per_element", "samples", "median_kernel_ns", "median_total_ns", "median_throughput_gbps", "stddev_kernel_ns"],
      "additionalProperties": false,
      "properties": {
        "kernel_id":              {"type": "integer"},
        "kernel_name":            {"type": "string"},
        "backend":                {"type": "string"},
        "precision":              {"type": "string"},
        "problem_size":           {"type": "integer", "minimum": 1},
        "bytes_per_element":      {"type": "integer", "minimum": 1},
        "samples":                {"type": "array", "items": {"$ref": "#/definitions/RawBenchmarkSample"}},
        "median_kernel_ns":       {"type": "integer", "minimum": 0},
        "median_total_ns":        {"type": "integer", "minimum": 0},
        "median_throughput_gbps": {"type": "number", "minimum": 0},
        "stddev_kernel_ns":       {"type": "number", "minimum": 0}
      }
    },
    "RawBenchmarkSample": {
      "type": "object",
      "required": ["kernel_ns", "transfer_ns", "resident_ns", "total_ns", "throughput_gbps"],
      "additionalProperties": false,
      "properties": {
        "kernel_ns":        {"type": "integer", "minimum": 0},
        "transfer_ns":      {"type": "integer", "minimum": 0},
        "resident_ns":      {"type": "integer", "minimum": 0},
        "total_ns":         {"type": "integer", "minimum": 0},
        "throughput_gbps":  {"type": "number", "minimum": 0}
      }
    }
  }
}
