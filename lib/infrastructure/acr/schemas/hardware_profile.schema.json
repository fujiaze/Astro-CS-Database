{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/acr-hardware-profile.schema.json",
  "title": "AstroCS ACR HardwareProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fingerprint",
    "profile_status",
    "devices",
    "capabilities",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "fingerprint": {
      "type": "object",
      "required": [
        "acr_commit",
        "os",
        "compiler",
        "dependencies"
      ],
      "properties": {
        "acr_commit": {
          "type": "string",
          "minLength": 7
        },
        "os": {
          "type": "string"
        },
        "compiler": {
          "type": "string"
        },
        "build_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "object"
        },
        "cpu": {
          "type": "object"
        },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "profile_status": {
      "enum": [
        "valid",
        "partial",
        "stale",
        "invalid"
      ]
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "device_id",
          "kind",
          "name",
          "healthy"
        ],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "cpu",
              "gpu",
              "accelerator"
            ]
          },
          "name": {
            "type": "string"
          },
          "healthy": {
            "type": "boolean"
          },
          "backend": {
            "type": "string"
          },
          "memory_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "numa_node": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "arithmetic",
        "memory",
        "overhead"
      ],
      "properties": {
        "arithmetic": {
          "$ref": "#/$defs/curveFamily"
        },
        "memory": {
          "$ref": "#/$defs/curveFamily"
        },
        "transfer": {
          "$ref": "#/$defs/curveFamily"
        },
        "reduction": {
          "$ref": "#/$defs/curveFamily"
        },
        "convolution": {
          "$ref": "#/$defs/curveFamily"
        },
        "irregular": {
          "$ref": "#/$defs/curveFamily"
        },
        "branch": {
          "$ref": "#/$defs/curveFamily"
        },
        "overhead": {
          "$ref": "#/$defs/curveFamily"
        },
        "library": {
          "$ref": "#/$defs/curveFamily"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "holdout_cases",
        "median_relative_error",
        "profile_hash"
      ],
      "properties": {
        "holdout_cases": {
          "type": "integer",
          "minimum": 0
        },
        "median_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "p95_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "curveFamily": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "device_id",
          "key",
          "points",
          "confidence"
        ],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "key": {
            "type": "object"
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "size",
                "median_ns"
              ],
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "median_ns": {
                  "type": "number",
                  "minimum": 0
                },
                "p95_ns": {
                  "type": "number",
                  "minimum": 0
                },
                "throughput": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string"
                },
                "samples": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": true
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "invalid"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
