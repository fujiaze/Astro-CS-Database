{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/typed-dag-v1.json",
  "title": "AstroCS Typed DAG v1 (RT-001)",
  "description": "类型化运行图 node 定义合同: 每 node 声明 node_id/module_id/operation/input ports/output ports/config/resource_class; 顶层 phase 声明图所属 Phase。每个 node 只绑定一个真实 operation; 端口以 artifact: 引用显式连线(禁隐式文件路径绑定); 同一 phase 内可连, 跨 phase edge 由 compiler 拒绝(阶段间仅磁盘产品交换)。node 标识字段与既有 PipelineIR 一致采用 node_id(规格 'id' 的工程名)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pipeline_id", "phase", "version", "nodes", "outputs"],
  "properties": {
    "schema": { "const": "astrocs.typed-dag/v1" },
    "pipeline_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "phase": { "enum": ["phase1", "phase2", "phase3"] },
    "version": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "module_id", "operation", "inputs", "outputs", "config", "resources"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "module_id": { "type": "string", "pattern": "^astrocs\\.[a-z0-9_.-]+$" },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "description": "节点绑定的唯一真实 operation 名; 编译时按 module_id 的 registry 绑定表解析为唯一 operation; 未登记/与 module 声明冲突即拒绝。"
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^artifact:[A-Za-z0-9_.:-]+$" },
            "description": "port -> artifact: 引用(显式数据边; 禁止隐式文件路径/裸路径字符串)。"
          },
          "outputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^artifact:[A-Za-z0-9_.:-]+$" }
          },
          "config": { "type": "object" },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class"],
            "properties": {
              "class": { "enum": ["metadata", "io", "cpu_light", "cpu_heavy"] },
              "parallel": { "type": "boolean" }
            },
            "allOf": [
              {
                "if": { "properties": { "class": { "const": "cpu_heavy" } } },
                "then": { "properties": { "parallel": { "const": true } } }
              }
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^artifact:[A-Za-z0-9_.:-]+$" }
    }
  }
}
