{
  "version": 6,
  "configurePresets": [
    {
      "name": "design",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/design",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ACSD_BUILD_SCIENCE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "design",
      "configurePreset": "design"
    }
  ],
  "testPresets": [
    {
      "name": "design",
      "configurePreset": "design",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
