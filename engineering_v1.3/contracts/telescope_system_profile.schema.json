{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroCS Telescope System Profile",
  "type": "object",
  "required": [
    "system_id",
    "telescope",
    "camera",
    "pixel_size_um",
    "image_width",
    "image_height",
    "filters",
    "source_documents"
  ],
  "properties": {
    "system_id": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "telescope": {
      "type": "object"
    },
    "camera": {
      "type": "object"
    },
    "pixel_size_um": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "image_width": {
      "type": "integer",
      "minimum": 1
    },
    "image_height": {
      "type": "integer",
      "minimum": 1
    },
    "binning": {
      "type": "string"
    },
    "gain": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "offset": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
