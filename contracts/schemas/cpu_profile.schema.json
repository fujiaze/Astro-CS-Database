            },
            "runtime_build_id": {
              "type": "string",
              "minLength": 1
            },
            "provider_build_ids": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "provider id -> loaded / fail_reason（provider hash 绑定面）"
            }
          }
        },
        "memory_bandwidth": {
          "type": "object",
          "required": [
            "copy",
            "read",
            "write",
            "triad"
