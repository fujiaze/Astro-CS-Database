              "type": "number",
              "exclusiveMinimum": 0
            },
            "write": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "triad": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "raw_samples_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kernels": {
