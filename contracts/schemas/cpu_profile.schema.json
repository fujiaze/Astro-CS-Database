      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "created_at_utc": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "quick",
            "full"
          ]
        },
        "hardware": {
          "type": "object",
          "required": [
            "fingerprint",
            "architecture",
            "vendor",
            "family",
            "model",
            "stepping",
            "feature_bits",
            "xcr0",
            "available_logical_cpus",
            "affinity"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "minLength": 16
            },
            "architecture": {
              "const": "amd64"
            },
            "vendor": {
              "type": "string"
            },
            "family": {
              "type": "integer"
            },
            "model": {
              "type": "integer"
            },
            "stepping": {
              "type": "integer"
            },
            "microcode": {
              "type": [
                "string",
                "null"
              ]
            },
            "feature_bits": {
              "type": [
                "array",
                "integer"
              ],
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "description": "实测口径为整数（profile_gen.cpp:86 取 hardware_inspect feature_bits:integer）；原 schema 文本写 array，两口径并存以不误拒真实 v1 profile"
            },
            "xcr0": {
              "type": [
                "string",
                "integer"
              ],
              "description": "实测口径为整数（profile_gen.cpp:87）；原 schema 文本写 string"
            },
            "available_logical_cpus": {
              "type": "integer",
              "minimum": 1
            },
            "affinity": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "numa": {
              "type": "object"
            },
            "memory_limit_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "build": {
          "type": "object",
          "required": [
            "version",
            "commit",
            "cli_sha256",
            "abi_version",
            "backend_sha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "cli_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "abi_version": {
              "type": "integer",
              "minimum": 1
            },
            "backend_sha256": {
              "type": [
                "object",
                "string"
              ],
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "description": "实测口径为字符串（profile_gen.cpp:96 写 --backend-sha 实参）；原 schema 文本写 object"
            }
          },
          "additionalProperties": true
        },
        "memory_benchmark": {
          "type": "object"
        },
        "kernels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/kernel_v1"
          }
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
