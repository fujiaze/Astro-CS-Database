            },
            "quota_signature": {
              "type": "string"
            }
          }
        },
        "build": {
          "type": "object",
          "required": [
            "astrocs_version",
            "source_commit",
            "benchmark_binary_sha256",
            "runtime_build_id",
            "provider_build_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "astrocs_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.+-]*)?$",
