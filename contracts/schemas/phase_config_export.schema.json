{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/phase_config/export/v1",
  "title": "AstroCS phase_config — export v1",
  "description": "CFG-001 建立的 export 科学配置合同：只含科学参数、输入路径、output_dir 与算法选择；不含任何硬件字段（ISA/workers/block/CPU 型号）。",
  "x-astrocs-schema-family": "phase_config",
  "x-astrocs-phase": "export",
  "x-astrocs-config-class": "phase_config",
  "x-astrocs-writer": "用户 / cli --template",
  "x-astrocs-not-writable-by": [
    "benchmark"
  ],
  "x-astrocs-authority": [
    "ASTROCS_DESIGN.md §3.3（输入合同 JSON 数据块：config + inputs）",
    "ASTROCS_DESIGN.md §3.5（运行前预检绿/橙/红）",
    "ASTROCS_DESIGN.md §6.1-§6.3（配置挂载 / 模板 / 机器输出）",
    "docs/design/UNIFIED_MODEL.md §3（三类配置严格分离）",
    "docs/plugins/infrastructure/18_cli.md §3-§5"
  ],
  "x-astrocs-notes": [
    "字段名与 DATA-001 锚点 docs/contracts/config_separation_anchors.json 的关系：phase_config 顶层键 {phase_name, config, inputs} 与内层键（precision/output_dir/sparse_snr_layer/light/bias/dark/flat/cosmetic/filter 等）以 ASTROCS_DESIGN.md §3.3 的 JSON 数据块为准（最高权威）；锚点的 ^sci_*/^(input|output)_*/^algorithm_*/^phase_name$ 命名族用于「算法选择」与「输入输出路径」类字段（本 schema 的 algorithm_* 与 output_* 即该族）。",
    "硬件字段禁令：ISA/workers/block/CPU 型号等一律不得出现在 phase_config（UNIFIED_MODEL.md §3；config_separation_anchors.json cross_class_forbidden.cpu_profile_keys_in_phase_config）。本 schema 用 additionalProperties:false 在 config 与 inputs 项两级做机器拒绝。",
    "算法选择的逐项权威见 docs/contracts/CONFIG_CONTRACT.md §3。"
  ],
  "type": "object",
  "required": [
    "phase_name",
    "config",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "phase_name": {
      "const": "export",
      "description": "phase 判别键（锚点 ^phase_name$）"
    },
    "config": {
      "$ref": "#/$defs/export_config"
    },
    "inputs": {
      "$ref": "#/$defs/export_inputs"
    }
  },
  "$defs": {
    "filter_name": {
      "type": "string",
      "enum": [
        "Antlia V Pro Series B",
        "Antlia V Pro Series G",
        "Antlia V Pro Series R",
        "Astrodon E-series B",
        "Astrodon E-series G",
        "Astrodon E-series R",
        "Astrodon I-series B",
        "Astrodon I-series G",
        "Astrodon I-series R",
        "Astronomik Deep Sky B",
        "Astronomik Deep Sky G",
        "Astronomik Deep Sky R",
        "Astronomik Typ 2c B",
        "Astronomik Typ 2c G",
        "Astronomik Typ 2c R",
        "Astronomik UV-IR Block L-1",
        "Astronomik UV-IR Block L-2",
        "Astronomik UV-IR Block L-3",
        "Baader B",
        "Baader G",
        "Baader R",
        "Baader UV/IR Cut / L CMOS Optimized",
        "Baader 7nm H-alpha",
        "Baader 8.5nm OIII",
        "Chroma B",
        "Chroma G",
        "Chroma R",
        "IDAS LPS P3 Light Pollution",
        "Johnson B",
        "Johnson I",
        "Johnson R",
        "Johnson U",
        "Johnson V",
        "Optolong B",
        "Optolong G",
        "OPTOLONG L-PRO Light Pollution",
        "Optolong R",
        "SDSS g",
        "SDSS i",
        "SDSS r",
        "SDSS u",
        "SDSS z",
        "ZWO B",
        "ZWO G",
        "ZWO R"
      ],
      "description": "滤镜库键，必须逐字命中 config/filters.json 的 filters 键（未知滤镜 -> error，ASTROCS_DESIGN.md §3.3/:144；enum 由 tests/config 断言与滤镜库逐项相等）"
    },
    "precision": {
      "enum": [
        "fp32",
        "fp64"
      ],
      "description": "科学计算精度，显式声明（ASTROCS_DESIGN.md §3.3:145）；默认 fp64 见 docs/science/SCIENCE_SCOPE.md:53"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "description": "运行产物唯一落点；不得以进程 CWD 作隐式缺省（ASTROCS_DESIGN.md §6.3:340）"
    },
    "export_config": {
      "type": "object",
      "required": [
        "output_dir",
        "precision",
        "output_mode",
        "wcs"
      ],
      "additionalProperties": false,
      "properties": {
        "output_dir": {
          "$ref": "#/$defs/output_dir"
        },
        "precision": {
          "$ref": "#/$defs/precision"
        },
        "output_mode": {
          "enum": [
            "surface_brightness",
            "point_source_flux",
            "visualization"
          ],
          "description": "输出模式必须显式（ASTROCS_DESIGN.md §5.3:267）；默认 surface_brightness 见 docs/plugins/algorithms_phase3/16_fits_output.md:41"
        },
        "wcs": {
          "$ref": "#/$defs/export_wcs"
        }
      }
    },
    "export_wcs": {
      "type": "object",
      "required": [
        "projection",
        "center_deg",
        "s_out_deg",
        "width_px",
        "height_px"
      ],
      "additionalProperties": false,
      "properties": {
        "projection": {
          "enum": [
            "tan",
            "sin",
            "car",
            "ait",
            "stg",
            "mol",
            "cea",
            "zea"
          ],
          "description": "投影选择，缺省 TAN（ASTROCS_DESIGN.md §5.3:264-266；docs/plugins/algorithms_phase3/14_projection.md:31）"
        },
        "center_deg": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            {
              "type": "number",
              "minimum": -85,
              "maximum": 85
            }
          ],
          "description": "[RA, Dec] ICRS deg（PHASE3_HIPS_TO_FITS.md:30,:38,:48：abs(dec)<=85°；RA 归一 [0,360)）"
        },
        "s_out_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "输出像元角尺度 deg/px（PHASE3_HIPS_TO_FITS.md:29,:48 s_out>0）"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "description": "W_out（PHASE3_HIPS_TO_FITS.md:31,:48 ∈[1,20000]）"
        },
        "height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "description": "H_out（同上）"
        },
        "rotation_deg": {
          "type": "number",
          "description": "旋转角（若用 CD）；默认 0（docs/plugins/algorithms_phase3/14_projection.md:35）"
        },
        "crpix_px": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "description": "参考像素（FITS 1-based）；缺省=中心（docs/plugins/algorithms_phase3/14_projection.md:32）"
        }
      }
    },
    "export_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "product"
        ],
        "additionalProperties": false,
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1,
            "description": "合同兼容 HiPS 产品路径（ASTROCS_DESIGN.md §5.1-§5.2；NESTED ordering，PHASE3_HIPS_TO_FITS.md:42）"
          }
        }
      }
    }
  }
}
