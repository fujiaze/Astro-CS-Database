{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/v6/psfsw.v1.schema.json",
  "title": "AstroCS V6 psfsw_robust 四分量与复合权重（生产，W6 集成）",
  "description": "[生产 schema | SCHEMA-INTEGRATE-001/W6] 由 contracts/proposals/v6/data/astrocs.v6.psfsw.v1.schema.json 机械迁移；语义权威 = docs/contracts/v6/frozen/astrocs.v6.contract-freeze.v1.json（条款 id 见 x-astrocs-production.clause_ids）。词表归一：weight.kind / weight.units / group_normalized / normalization.scope 为唯一 canonical 名，legacy 别名与双向映射见 contracts/data/v6_weight_vocabulary_v1.json 与 v6_migration_map_v1.json。PENDING_OWNER_SIGNOFF 条款生效前 fail-closed，不得放宽。原描述：PSFSW 是正式可选 conventional integration 权重（非 QA-only），但无量纲、组内相对，不得写成 ivar/Fisher/W_info。四分量 psfsw.signal / psfsw.concentration / psfsw.noise / psfsw.background 分别落产品，measurement_id 互异，各带 p05/p50/p95 与有效覆盖。复合 Wt_k=C_norm*S^alpha*Conc^beta/(N^gamma*B^delta)，W_psfsw,k=Wt_k/median_j(Wt_j)。covariance 只能从实际组合系数传播，effective PSF 必输。",
  "x-astrocs-canonical-object-retirement": {
    "note": "本文件属 v6 合同层，按 工程控制/RELEASE-03/GAP_AUDIT.md §4.1 Q2 裁决在位保留为「设计档案 / 产品族专用投影（非生产目标态）」，文件不删。统一对象 canonical psfsw_robust_weight retired（负责人 2026-09-20 裁决 B，14→13；变更编号 CHG-2026-09-20-PSFSW-RETIRE；依据 ASTROCS_DESIGN.md §2.1/§2.2/§2.3 与 工程控制/RELEASE-02/GAP_AUDIT.md §9.73 裁决 A44）：contracts/schemas/unified/psfsw_robust_weight.schema.json 与其正例已删除，端口合同枚举不再接受该对象。本文件中的 psfsw_robust_weight 是 v6 提案/产品族内部标识（weight.kind 值、单位表符号、variance_from 禁止项 token），不是统一对象 canonical 引用；旧产品声明该对象 ⇒ 显式拒绝 + 迁移提示（contracts/data/unified_object_compatibility_map_v1.json#retired_entries）。",
    "retired_canonical_object": "psfsw_robust_weight",
    "retired_at_change": "CHG-2026-09-20-PSFSW-RETIRE",
    "v6_layer_status": "retained_design_archive"
  },
  "x-astrocs-forbidden-keys": [
    "ivar",
    "inverse_variance",
    "variance",
    "var",
    "sigma",
    "sigma2",
    "fisher",
    "fisher_information",
    "information",
    "w_info",
    "w_psf"
  ],
  "x-astrocs-extended-guard-keys": [
    "snr",
    "snr2",
    "support",
    "coverage"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "psfsw_schema",
    "schema_version",
    "weight_mode",
    "weight",
    "components",
    "composite",
    "common_star_set",
    "validity",
    "covariance_ref",
    "effective_psf_ref",
    "provenance_ref",
    "component_flux_unit"
  ],
  "properties": {
    "psfsw_schema": {
      "const": "astrocs.v6.psfsw/v1",
      "x-astrocs": {
        "anchor": "FZ-FIELD-PSFSW-4COMP; PSF_SIGNAL_WEIGHT §3",
        "domain": "Phase1/2 PSFSW"
      }
    },
    "schema_version": {
      "const": 1,
      "x-astrocs": {
        "anchor": "宪章 §4.3",
        "domain": "全部"
      }
    },
    "weight_mode": {
      "const": "psfsw_robust",
      "x-astrocs": {
        "anchor": "FZ-MODE-PRODUCTION; ADJ-S1",
        "domain": "Phase2 psfsw_robust",
        "fail_closed": "weight_mode != psfsw_robust -> 本 schema 不适用",
        "gate": "G-WEIGHTMODE-ENUM"
      }
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "units",
        "group_normalized",
        "normalization",
        "weight_value"
      ],
      "properties": {
        "kind": {
          "const": "psfsw_robust_weight",
          "x-astrocs": {
            "anchor": "FZ-FIELD-PSFSW-UNIT; ADJ-GEN-02",
            "domain": "全部",
            "fail_closed": "kind 写成 ivar/fisher/information -> REJECT",
            "gate": "G-PSFSW-KIND"
          }
        },
        "units": {
          "const": "1",
          "x-astrocs": {
            "anchor": "FZ-UNIT-PSFSW",
            "domain": "全部",
            "fail_closed": "units 含 flux^-2/ivar/1/flux^2 -> REJECT",
            "gate": "G-PSFSW-UNIT"
          }
        },
        "group_normalized": {
          "const": true,
          "x-astrocs": {
            "anchor": "FZ-FIELD-PSFSW-UNIT",
            "domain": "全部",
            "fail_closed": "group_normalized=false -> REJECT",
            "gate": "G-PSFSW-NORMALIZATION"
          }
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "median_target",
            "constants_version"
          ],
          "properties": {
            "scope": {
              "const": "group",
              "x-astrocs": {
                "anchor": "FZ-FIELD-PSFSW-UNIT; SCI-PSFW-001 §3",
                "domain": "全部",
                "fail_closed": "scope=global 且无 selection function -> REJECT",
                "gate": "G-PSFSW-NORMALIZATION"
              }
            },
            "median_target": {
              "const": 1.0,
              "x-astrocs": {
                "anchor": "FZ-FORMULA-PSFSW-COMPOSITE",
                "domain": "全部",
                "fail_closed": "组内 median != 1 -> REJECT",
                "gate": "G-PSFSW-NORMALIZATION"
              }
            },
            "constants_version": {
              "type": "string",
              "minLength": 1,
              "x-astrocs": {
                "anchor": "SCI-PSFW-001 §3; ADJ-P2-03",
                "domain": "全部",
                "fail_closed": "版本串为空 -> REJECT",
                "gate": "G-PSFSW-CONSTANTS-VERSION"
              }
            }
          }
        },
        "weight_value": {
          "type": [
            "number",
            "null"
          ],
          "x-astrocs": {
            "anchor": "FZ-GATE-PSFSW-FAILCLOSED",
            "domain": "全部",
            "fail_closed": "valid=false 时 weight_value 必须 null；否则 REJECT",
            "gate": "G-PSFSW-FAILCLOSED"
          }
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "ivar",
            "inverse_variance",
            "variance",
            "var",
            "sigma",
            "sigma2",
            "fisher",
            "fisher_information",
            "information",
            "w_info",
            "w_psf"
          ]
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "concentration",
        "noise",
        "background"
      ],
      "properties": {
        "signal": {
          "$ref": "#/$defs/component",
          "x-astrocs": {
            "anchor": "FZ-FIELD-PSFSW-4COMP; PSFW_FREEZE §4.2",
            "domain": "全部",
            "fail_closed": "分量单位必须等于 component_flux_unit（组内常量）；不等或含 flux^-2/ivar → REJECT",
            "gate": "G-PSFSW-4COMP"
          }
        },
        "concentration": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "units": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_()^\\-]*/px\\^2$"
                }
              }
            }
          ],
          "x-astrocs": {
            "anchor": "ALG-P2-PSFSW-001 单位一致性规则（Conc_k = component_flux_unit/px^2）; FZ-FIELD-PSFSW-4COMP; A_NEA=px^2",
            "domain": "全部",
            "fail_closed": "concentration.units != component_flux_unit + '/px^2'（含 legacy 文本错误 'ADU/px'）→ REJECT；禁 FWHM/拟合残差代替",
            "gate": "G-PSFSW-4COMP-UNITS"
          }
        },
        "noise": {
          "$ref": "#/$defs/component",
          "x-astrocs": {
            "anchor": "FZ-FIELD-PSFSW-4COMP; PSFW_FREEZE §4.2 (稳健估计器须版本化)",
            "domain": "全部",
            "fail_closed": "分量单位必须等于 component_flux_unit（组内常量）；不等或含 flux^-2/ivar → REJECT",
            "gate": "G-PSFSW-4COMP"
          }
        },
        "background": {
          "$ref": "#/$defs/component",
          "x-astrocs": {
            "anchor": "FZ-FIELD-PSFSW-4COMP; FZ-GATE-PSFSW-FAILCLOSED",
            "domain": "全部",
            "fail_closed": "分量单位必须等于 component_flux_unit（组内常量）；不等或含 flux^-2/ivar → REJECT",
            "gate": "G-PSFSW-FAILCLOSED"
          }
        }
      }
    },
    "composite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula_ref",
        "exponents",
        "C_norm_version",
        "truncation",
        "estimator_version"
      ],
      "properties": {
        "formula_ref": {
          "const": "Wt_k = C_norm * S_k^alpha * Conc_k^beta / (N_k^gamma * B_k^delta); W_psfsw,k = Wt_k / median_j(Wt_j)"
        },
        "exponents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alpha",
            "beta",
            "gamma",
            "delta"
          ],
          "properties": {
            "alpha": {
              "type": "number",
              "minimum": 0
            },
            "beta": {
              "type": "number",
              "minimum": 0
            },
            "gamma": {
              "type": "number",
              "minimum": 0
            },
            "delta": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "C_norm_version": {
          "type": "string",
          "minLength": 1
        },
        "truncation": {
          "type": "string",
          "minLength": 1
        },
        "estimator_version": {
          "type": "string",
          "minLength": 1
        },
        "calibration_sample_id": {
          "type": "string",
          "x-astrocs": {
            "anchor": "SCI-PSFW-001 §3 (标定样本 != 验收样本)",
            "domain": "全部",
            "fail_closed": "标定样本与验收样本相同 -> REJECT",
            "gate": "G-PSFSW-CALIB-SAMPLE"
          }
        }
      },
      "x-astrocs": {
        "anchor": "FZ-FORMULA-PSFSW-COMPOSITE; ADJ-P2-03",
        "domain": "全部",
        "fail_closed": "指数/常数/截断未版本化 -> REJECT",
        "gate": "G-PSFSW-CONSTANTS-VERSION"
      }
    },
    "common_star_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_star_set_id",
        "selection_function_id",
        "members_hash",
        "construction",
        "n_common",
        "exclusion_flags"
      ],
      "properties": {
        "common_star_set_id": {
          "type": "string",
          "minLength": 1,
          "x-astrocs": {
            "anchor": "FZ-GATE-PSFSW-FAILCLOSED",
            "domain": "全部",
            "fail_closed": "缺失 -> unavailable(no_common_star_set)",
            "gate": "G-PSFSW-STARSET"
          }
        },
        "selection_function_id": {
          "type": "string",
          "minLength": 1,
          "x-astrocs": {
            "anchor": "SCI-PSFW-001 §3; PSFW_FREEZE §5.1",
            "domain": "全部",
            "fail_closed": "缺失 -> unavailable(selection_bias_gate_failed)",
            "gate": "G-PSFSW-STARSET"
          }
        },
        "members_hash": {
          "type": "string",
          "minLength": 1,
          "x-astrocs": {
            "anchor": "RULINGS.md #4; ADJ-P2-03",
            "domain": "全部",
            "fail_closed": "缺哈希 -> 不可审计 REJECT",
            "gate": "G-PSFSW-STARSET"
          }
        },
        "construction": {
          "enum": [
            "external_catalog",
            "reference_stack_threshold"
          ],
          "x-astrocs": {
            "anchor": "PSFW_FREEZE §5.2 (禁止逐帧检测取交)",
            "domain": "全部",
            "fail_closed": "逐帧检测阈值取交构造 -> REJECT(选择函数与测量耦合)",
            "gate": "G-PSFSW-STARSET"
          }
        },
        "n_common": {
          "type": "integer",
          "minimum": 3,
          "x-astrocs": {
            "anchor": "WEIGHT_PROVENANCE_GATE R5; PSFW_FREEZE §5.1",
            "domain": "全部",
            "fail_closed": "n_common < 3 -> unavailable(insufficient_valid_stars)",
            "gate": "G-PSFSW-STARSET",
            "signoff": "PENDING_OWNER_SIGNOFF: PSFSW-T-NMIN / SO-07；生效前 fail-closed（<3 即 unavailable(insufficient_valid_stars)），不得写成已冻结"
          }
        },
        "exclusion_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "saturated",
              "blended",
              "trailed",
              "moving",
              "psf_mismatch",
              "edge_truncated"
            ]
          },
          "x-astrocs": {
            "anchor": "SCI-PSFW-001 §3; PSFW_FREEZE §5.1",
            "domain": "全部",
            "fail_closed": "排除项未显式列举 -> REJECT",
            "gate": "G-PSFSW-STARSET"
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "reason"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "no_common_star_set",
            "background_nonpositive_undefined_transform",
            "insufficient_valid_stars",
            "selection_bias_gate_failed",
            "spatial_nonuniformity_gate_failed"
          ],
          "x-astrocs": {
            "anchor": "FZ-GATE-PSFSW-FAILCLOSED",
            "domain": "全部",
            "fail_closed": "valid=false 但 reason 缺失/不在白名单，或回退 median source SNR -> REJECT",
            "gate": "G-PSFSW-FAILCLOSED"
          }
