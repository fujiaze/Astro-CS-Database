    "effective_psf_ref": {
      "type": "string",
      "minLength": 1,
      "x-astrocs": {
        "anchor": "FZ-GATE-PSFSW-EPSF",
        "domain": "全部",
        "fail_closed": "effective PSF 缺失 -> REJECT",
        "gate": "G-EPSF-PRESENT"
      }
    },
    "baseline_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselines",
        "detection_power",
        "fwhm",
        "flux_bias",
        "surface_brightness_bias"
      ],
      "properties": {
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "equal",
              "exposure",
              "pixel_ivar",
              "W_info"
            ]
          },
          "uniqueItems": true
        },
        "detection_power": {
          "type": "object"
        },
        "fwhm": {
          "type": "object"
        },
        "flux_bias": {
          "type": "object"
        },
        "surface_brightness_bias": {
          "type": "object"
        }
      },
      "x-astrocs": {
        "anchor": "SCI-PSFW-001 §5/§7.4; DESIGN-P2 §6.3",
        "domain": "全部",
        "fail_closed": "缺基线比较或只声明'看起来更好' -> REJECT",
        "gate": "G-PSFSW-BASELINE"
      }
    },
    "provenance_ref": {
      "type": "string",
      "minLength": 1,
      "x-astrocs": {
