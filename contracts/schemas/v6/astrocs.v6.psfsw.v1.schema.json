        "domain": "全部"
      }
    },
    "component_flux_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "x-astrocs": {
        "anchor": "ALG-P2-PSFSW-001 四分量单位一致性规则; FZ-FIELD-PSFSW-4COMP",
        "domain": "Phase2 psfsw_robust",
        "fail_closed": "S_k/N_k/B_k 必须共享组内常量 component_flux_unit；未声明或组内不一致 → REJECT",
        "gate": "G-PSFSW-4COMP-UNITS"
      }
    }
  },
  "$defs": {
