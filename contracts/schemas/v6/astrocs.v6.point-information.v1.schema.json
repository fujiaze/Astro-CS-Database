{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/v6/point-information.v1.schema.json",
  "title": "AstroCS V6 point-source information / W_info 数据对象（生产，W6 集成）",
  "description": "[生产 schema | SCHEMA-INTEGRATE-001/W6] 由 contracts/proposals/v6/data/astrocs.v6.point-information.v1.schema.json 机械迁移；语义权威 = docs/contracts/v6/frozen/astrocs.v6.contract-freeze.v1.json（条款 id 见 x-astrocs-production.clause_ids）。词表归一：weight.kind / weight.units / group_normalized / normalization.scope 为唯一 canonical 名，legacy 别名与双向映射见 contracts/data/v6_weight_vocabulary_v1.json 与 v6_migration_map_v1.json。PENDING_OWNER_SIGNOFF 条款生效前 fail-closed，不得放宽。原描述：严格点源信息权重。权威式（FZ-FORMULA-WINFO/Q/FHAT）：W_info,k=a_k^2 P_k^T C_k^-1 P_k=1/Var(F_hat_k)；Q_k=a_k P_k^T C_k^-1 d_k；F_hat=Q/W；Var=1/W。单位 FZ-UNIT-WINFO=ADU^-2；Q=ADU^-1；flux=ADU。白噪声近似 FZ-COND-WHITENOISE 为条件式。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "point_information_schema",
    "schema_version",
    "authoritative_formula",
    "W_info",
    "Q",
    "flux",
    "flux_variance",
    "representation",
    "independent_frame_combination",
    "provenance_ref"
  ],
  "properties": {
    "point_information_schema": {
      "const": "astrocs.v6.point-information/v1",
      "x-astrocs": {
        "anchor": "FZ-FORMULA-WINFO; PSF_SIGNAL_WEIGHT §2",
        "domain": "Phase1 W_psf / Phase2 point_source / Phase3 point_source_flux"
      }
    },
    "schema_version": {
      "const": 1,
      "x-astrocs": {
        "anchor": "宪章 §4.3",
        "domain": "全部"
      }
    },
    "authoritative_formula": {
      "const": "Q_k=a_k P_k^T C_k^-1 d_k; W_info,k=a_k^2 P_k^T C_k^-1 P_k; F_hat=Q/W; Var(F_hat)=1/W",
      "x-astrocs": {
        "anchor": "FZ-FORMULA-WINFO; FZ-FORMULA-Q; FZ-FORMULA-FHAT; ADJ-P2-01",
        "domain": "point_information",
        "fail_closed": "权威式被替换/改写 -> REJECT",
        "gate": "G-WINFO-FORMULA"
      }
    },
    "W_info": {
      "$ref": "#/$defs/quantity",
      "x-astrocs": {
        "units": "ADU^-2",
        "anchor": "FZ-UNIT-WINFO",
        "domain": "全部",
        "fail_closed": "units != ADU^-2 -> REJECT",
        "gate": "G-WINFO-UNIT"
      }
    },
    "Q": {
      "$ref": "#/$defs/quantity",
      "x-astrocs": {
        "units": "ADU^-1",
        "anchor": "FZ-UNIT-Q",
        "domain": "全部",
        "fail_closed": "units != ADU^-1 -> REJECT",
        "gate": "G-Q-UNIT"
      }
    },
    "flux": {
      "$ref": "#/$defs/quantity",
      "x-astrocs": {
        "units": "ADU",
        "anchor": "FZ-UNIT-FLUX",
        "domain": "全部",
        "fail_closed": "units != ADU -> REJECT",
        "gate": "G-FLUX-UNIT"
      }
    },
    "flux_variance": {
      "$ref": "#/$defs/quantity",
      "x-astrocs": {
        "units": "ADU^2",
        "anchor": "FZ-UNIT-FLUX; FZ-UNIT-WINFO",
        "domain": "全部",
        "fail_closed": "Var(F_hat) != 1/W_info -> REJECT",
        "gate": "G-WINFO-VAR-INVERSER"
      }
    },
    "independent_frame_combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_frames",
        "Q_combined",
        "W_combined"
      ],
      "properties": {
        "independent_frames": {
          "type": "boolean"
        },
        "Q_combined": {
          "const": "Q = Sum_k Q_k"
        },
        "W_combined": {
          "const": "W = Sum_k W_info,k"
        },
        "joint_covariance_ref": {
          "type": "string"
        }
      },
      "x-astrocs": {
        "anchor": "UNIFIED §4; SCI-P2-001 §2.3; ADJ-P2-01",
        "domain": "全部",
        "fail_closed": "跨帧相关却用 Sum_k 求和(joint_covariance_ref 缺失) -> REJECT",
        "gate": "G-WINFO-JOINT-C"
      }
    },
    "white_noise_approximation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "conditions",
        "formula"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "C_diagonal",
            "sigma_pix_declared",
            "a_k_consistent"
          ],
          "properties": {
            "C_diagonal": {
              "type": "boolean"
            },
            "sigma_pix_declared": {
              "type": "boolean"
            },
            "a_k_consistent": {
              "type": "boolean"
            }
          }
        },
        "formula": {
          "const": "W_info,k = a_k^2/(sigma_pix,k^2 * A_NEA,k), A_NEA,k = 1/Sum_p P_k,p^2"
        }
      },
      "x-astrocs": {
        "anchor": "FZ-COND-WHITENOISE; ADJ-P2-01",
        "domain": "Phase1/2 点源",
        "fail_closed": "applied=true 而任一 condition 为 false -> REJECT(近似无适用域)",
        "gate": "G-WHITENOISE-COND"
      }
    },
    "a_nea_ref": {
      "type": "string",
      "x-astrocs": {
        "anchor": "DESIGN-P1 §6; FZ-COND-WHITENOISE",
        "domain": "白噪声"
      }
    },
    "representation": {
      "enum": [
        "map",
        "model",
        "control_points",
        "scalar"
      ],
      "x-astrocs": {
        "anchor": "UNIFIED §8; DESIGN-P1 §8.3; FZ-DEGRADE-SCALAR",
        "domain": "空间 W_psf(x,y)",
        "fail_closed": "scalar 未过均匀性/功率损失门或缺分位数 -> REJECT",
        "gate": "G-DEGRADE-SCALAR"
      }
    },
    "degradation": {
      "$ref": "#/$defs/degradation",
      "x-astrocs": {
        "anchor": "FZ-DEGRADE-SCALAR",
        "domain": "scalar"
      }
    },
    "optimality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "preconditions_met"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "enum": [
              "BLUE",
              "max_point_source_snr",
              "min_flux_variance"
            ]
          },
          "uniqueItems": true
        },
        "preconditions_met": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_correct",
            "P_normalized",
            "C_representable",
            "gaussian_or_crlb",
            "point_source_target"
          ],
          "properties": {
            "model_correct": {
              "type": "boolean"
            },
            "P_normalized": {
              "type": "boolean"
            },
            "C_representable": {
              "type": "boolean"
            },
            "gaussian_or_crlb": {
              "type": "boolean"
            },
            "point_source_target": {
              "type": "boolean"
            }
          }
        }
      },
      "x-astrocs": {
        "anchor": "ADJ-P2-01; PSF_SIGNAL_WEIGHT §3.3",
        "domain": "最优性声明",
        "fail_closed": "claims 非空而任一 precondition=false -> REJECT；无预条件不得声明最优",
        "gate": "G-WINFO-OPTIMALITY"
      }
    },
    "frame_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_id",
          "a_ref",
          "P_ref",
          "C_ref"
        ],
        "properties": {
          "frame_id": {
            "type": "string"
          },
          "a_ref": {
            "type": "string"
          },
          "P_ref": {
            "type": "string"
          },
          "C_ref": {
            "type": "string"
          }
        }
      },
      "x-astrocs": {
        "anchor": "ADJ-P2-01; DESIGN-P2 §6.2",
        "domain": "point_information",
        "fail_closed": "缺 P_k/a_k/C_k -> unavailable(PROJECT_SPEC §3/§4)",
        "gate": "G-WINFO-INPUTS"
      }
    },
    "provenance_ref": {
      "type": "string",
      "minLength": 1,
      "x-astrocs": {
        "anchor": "FZ-PROV-MINIMAL-SET",
        "domain": "全部"
      }
    }
  },
  "$defs": {
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p05",
        "p50",
        "p95",
        "max_systematic_deviation",
        "sampling_coverage",
        "model_error",
        "domain",
        "gates"
      ],
      "properties": {
        "p05": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "max_systematic_deviation": {
          "type": "number",
          "minimum": 0
        },
        "sampling_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model_error": {
          "type": "number",
          "minimum": 0
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "object"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "units"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "units": {
          "type": "string"
        },
        "representation": {
          "enum": [
            "scalar",
            "map",
            "model"
          ]
        }
      }
    }
  },
  "x-astrocs-production": {
    "task": "SCHEMA-INTEGRATE-001",
    "wave": 6,
    "status": "PRODUCTION_INTEGRATED",
    "source_proposal": "contracts/proposals/v6/data/astrocs.v6.point-information.v1.schema.json",
    "freeze_contract": "docs/contracts/v6/frozen/astrocs.v6.contract-freeze.v1.json",
    "clause_ids": [
      "FZ-FORMULA-WINFO",
      "FZ-FORMULA-Q",
      "FZ-FORMULA-FHAT",
      "FZ-UNIT-WINFO",
      "FZ-COND-WHITENOISE",
      "FZ-DEGRADE-SCALAR"
    ],
    "pending_owner_signoff_structural_refs": [],
    "signoff_policy": "PENDING_OWNER_SIGNOFF 条款保持待签并 fail-closed；不得写成已冻结"
  }
}
