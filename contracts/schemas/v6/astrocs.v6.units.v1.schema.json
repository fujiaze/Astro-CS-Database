{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/v6/units.v1.schema.json",
  "title": "AstroCS V6 冻结单位表（DATA-DESIGN-001 提案，SCHEMA-INTEGRATE-001/W6 归一）",
  "description": "[生产 schema | SCHEMA-INTEGRATE-001/W6] 由 contracts/proposals/v6/data/astrocs.v6.units.v1.schema.json 机械迁移；语义权威 = docs/contracts/v6/frozen/astrocs.v6.contract-freeze.v1.json（条款 id 见 x-astrocs-production.clause_ids）。词表归一：weight.kind / weight.units / group_normalized / normalization.scope 为唯一 canonical 名，legacy 别名与双向映射见 contracts/data/v6_weight_vocabulary_v1.json 与 v6_migration_map_v1.json。PENDING_OWNER_SIGNOFF 条款生效前 fail-closed，不得放宽。原描述：V6 目标态单位词汇表。语义源 = reports/v6/science-adjudication/adjudications.json units_table 与 docs/science/v6/adjudication/SCI-ADJ-001_FREEZE_LIST.md §1/§3.2；本文件是 DATA-DESIGN-001 的机器可读镜像，不改变冻结语义。任何下游 schema 的量纲字段必须引用本表符号与单位串。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "units_schema",
    "schema_version",
    "table",
    "quadratic_law",
    "bunit_semantics"
  ],
  "properties": {
    "units_schema": {
      "const": "astrocs.v6.units/v1"
    },
    "schema_version": {
      "const": 1
    },
    "table": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "unit",
          "meaning",
          "domain",
          "anchor"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "x-astrocs": {
              "anchor": "SCI-ADJ-001 units_table",
              "domain": "V6 全部 schema"
            }
          },
          "unit": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "variance_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "ivar_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "domain": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          }
        }
      }
    },
    "quadratic_law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "freeze_id"
      ],
      "properties": {
        "statement": {
          "const": "variance = signal^2; ivar = 1/variance; Phase3 variance BUNIT = (main HDU signal BUNIT)^2"
        },
        "freeze_id": {
          "const": "FZ-P3-BUNIT-QUADRATIC"
        }
      }
    },
    "bunit_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "freeze_id",
        "pixel_area_power_defaults"
      ],
      "properties": {
        "rule": {
          "const": "BUNIT 必须量纲可判: (a) 显式含 px 幂次(canonical ADU/px^2 与 ADU^2/px^4); 或 (b) BUNIT=ADU 时 provenance 必须声明 pixel_semantics=surface_brightness + pixel_area_power=-2 + 目标像素面积"
        },
        "freeze_id": {
          "const": "FZ-BUNIT-SEMANTICS"
        },
        "pixel_area_power_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal_sb",
            "sb_variance_out",
            "sb_ivar_out",
            "flux",
            "Q",
            "W_info",
            "psfsw_robust_weight"
          ],
          "properties": {
            "signal_sb": {
              "const": -2
            },
            "sb_variance_out": {
              "const": -4
            },
            "sb_ivar_out": {
              "const": 4
            },
            "flux": {
              "const": 0
            },
            "Q": {
              "const": 0
            },
            "W_info": {
              "const": 0
            },
            "psfsw_robust_weight": {
              "const": 0
            }
          }
        }
      }
    }
  },
  "x-astrocs-production": {
    "task": "SCHEMA-INTEGRATE-001",
    "wave": 6,
    "status": "PRODUCTION_INTEGRATED",
    "source_proposal": "contracts/proposals/v6/data/astrocs.v6.units.v1.schema.json",
    "freeze_contract": "docs/contracts/v6/frozen/astrocs.v6.contract-freeze.v1.json",
    "clause_ids": [
      "FZ-UNIT-SIGNAL-SB",
      "FZ-UNIT-Q",
      "FZ-UNIT-FLUX",
      "FZ-UNIT-WINFO",
      "FZ-UNIT-PSFSW",
      "FZ-UNIT-VAR-IN",
      "FZ-UNIT-VAR-SB",
      "FZ-UNIT-IVAR-SB",
      "FZ-P3-BUNIT-QUADRATIC",
      "FZ-BUNIT-SEMANTICS"
    ],
    "pending_owner_signoff_structural_refs": [],
    "signoff_policy": "PENDING_OWNER_SIGNOFF 条款保持待签并 fail-closed；不得写成已冻结"
  }
}
