{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/unified/rejection/v1",
  "title": "AstroCS 统一对象 rejection —— 污染推断结果",
  "description": "UNIFIED_MODEL §2：rejection = 污染推断结果；可否作权重 = 门/概率，不是 coverage。rejection 必须携带污染推断本体；禁止把 coverage（几何有效域）当作 rejection 提交。",
  "x-astrocs-object": {
    "name": "rejection",
    "canonical_file": "contracts/schemas/unified/rejection.schema.json",
    "authority": "docs/design/UNIFIED_MODEL.md §2；ASTROCS_DESIGN.md §2；ENGINEERING_SPEC.md §3/§4.7",
    "weight_verdict": "门/概率，不是 coverage",
    "weight_eligible": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unified_object",
    "object_schema_id",
    "schema_version",
    "units",
    "missing_value",
    "precision",
    "object_weight_capability",
    "object_weight_verdict",
    "provenance",
    "pollution_inference",
    "role"
  ],
  "propertyNames": {
    "pattern": "^(?!(weight|value|mask|snr)$)(?!(weight|value|mask|snr)(_|$))(?!(weight|value|mask)(_|$)).*$"
  },
  "properties": {
    "unified_object": {
      "const": "rejection",
      "description": "对象判别式：本文档声明的 UNIFIED_MODEL §2 对象名（禁止用别的对象名冒充）"
    },
    "object_schema_id": {
      "const": "https://astrocs.local/schemas/unified/rejection/v1",
      "description": "全局唯一 schema ID（contracts/schemas/unified/rejection.schema.json）"
    },
    "schema_version": {
      "const": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bunit",
        "bunit_semantics",
        "pixel_semantics",
        "pixel_area_power"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "bunit": {
          "const": "1",
          "description": "rejection 为无量纲门/概率"
        },
        "bunit_semantics": {
          "description": "FZ-BUNIT-SEMANTICS：written_px_power = BUNIT 显式含 px 幂次；declared_via_provenance = BUNIT 仅写 ADU 时必须由 provenance 声明 pixel_semantics + pixel_area_power",
          "enum": [
            "written_px_power",
            "declared_via_provenance"
          ]
        },
        "pixel_semantics": {
          "const": "probability"
        },
        "pixel_area_power": {
          "const": 0
        },
        "target_pixel_area": {
          "description": "目标像素面积（BUNIT=ADU 且 surface_brightness 时必需）",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bunit": {
                "pattern": "/px\\^2"
              }
            },
            "required": [
              "bunit"
            ]
          },
          "then": {
            "properties": {
              "bunit_semantics": {
                "const": "written_px_power"
              },
              "pixel_semantics": {
                "const": "surface_brightness"
              },
              "pixel_area_power": {
                "const": -2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bunit_semantics": {
                "const": "declared_via_provenance"
              }
            },
            "required": [
              "bunit_semantics"
            ]
          },
          "then": {
            "required": [
              "target_pixel_area"
            ],
            "properties": {
              "pixel_semantics": {
                "const": "surface_brightness"
              },
              "pixel_area_power": {
                "const": -2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pixel_semantics": {
                "const": "integrated_flux"
              }
            },
            "required": [
              "pixel_semantics"
            ]
          },
          "then": {
            "properties": {
              "pixel_area_power": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "missing_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_repr",
        "invalid_repr"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "missing_repr": {
          "description": "缺失表示（对象文档不得省略该声明）",
          "enum": [
            "null",
            "absent_key",
            "zero",
            "null_or_absent",
            "unavailable_object"
          ]
        },
        "invalid_repr": {
          "description": "无效值表示",
          "enum": [
            "null",
            "nan",
            "zero",
            "nan_or_negative",
            "mask_bit",
            "unavailable_object",
            "not_applicable"
          ]
        },
        "nan_in_binary": {
          "description": "二进制平面是否允许 NaN 承载 invalid（JSON 无 NaN 字面量）",
          "type": "boolean"
        },
        "silent_zero_forbidden": {
          "description": "禁止用 0 冒充缺失/不可用（静默 0 = fail-closed）",
          "type": "boolean"
        },
        "sentinel_note": {
          "description": "补充说明（不得引入第二套无效值口径）",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "precision": {
      "description": "精度：float32 / float64 / integer（与 DATA_SEMANTICS §6 一致，不得自定第二套）",
      "enum": [
        "float32",
        "float64",
        "integer"
      ]
    },
    "object_weight_capability": {
      "const": false,
      "description": "UNIFIED_MODEL §2「可否作权重」列的机器判定（照抄，不得自行改判定）"
    },
    "object_weight_verdict": {
      "const": "门/概率，不是 coverage",
      "description": "UNIFIED_MODEL §2「可否作权重」列原文（逐字）"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_chain"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "source_chain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "description": "上游产品/输入标识（产物引用，悬空即 REJECT）",
            "type": "string",
            "minLength": 1
          },
          "description": "来源链：本对象由哪些上游产物/输入派生（FZ-PROV-MINIMAL-SET 的对象级最小集）"
        },
        "software_sha": {
          "description": "生成该对象的软件完整 SHA（40 hex）",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "config_hash": {
          "description": "配置哈希（run_manifest.config_hash）",
          "type": "string",
          "minLength": 1
        },
        "algorithm_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "description": "算法条款 ID（ALG-* / SCI-*）",
            "type": "string",
            "minLength": 1
          }
        },
        "generated_utc": {
          "description": "生成时间 UTC（ISO-8601，Z 结尾）",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "pollution_inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimator",
        "reason_code"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "estimator": {
          "description": "污染推断估计器（版本化）",
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "description": "拒绝原因码（SCI-REJ 值域）",
          "enum": [
            "ACCEPTED",
            "REJECTED_LOW",
            "REJECTED_HIGH",
            "UNDERDETERMINED"
          ]
        },
        "rejection_probability": {
          "description": "污染推断概率 ∈ [0,1]（可选）",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold_ref": {
          "description": "阈值条款引用（阈值本体在 SCI/ALG，不在本 schema）",
          "type": "string",
          "minLength": 1
        }
      },
      "description": "污染推断本体（rejection 的必需载体）"
    },
    "rejected_sample_count": {
      "description": "被拒样本数（诊断统计；可选）",
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "description": "角色：门/概率",
      "enum": [
        "gate",
        "probability"
      ]
    }
  }
}
