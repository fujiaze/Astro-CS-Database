{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/v6/signal.v1.schema.json",
  "title": "AstroCS V6 signal 数据对象（DATA-DESIGN-001 提案）",
  "description": "signal 是声明单位和像素语义的科学估计量（宪章 §4.1），不是权重。覆盖 Phase1 Drizzle 面亮度、Phase2 马赛克 signal、Phase3 输出 signal。权威公式：S_p=Sum_j B_j a_jp/Sum_j a_jp（FZ-FORMULA-DRIZZLE-SB）；Phase3 y=R x（DESIGN-P3 §4）。单位冻结见 astrocs.v6.units.v1.schema.json 与 FZ-UNIT-SIGNAL-SB。",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_schema", "schema_version", "physical_quantity", "units", "pixel_semantics", "pixel_area_power", "product_family", "representation", "dtype", "invalid_policy", "provenance_ref"],
  "properties": {
    "signal_schema": { "const": "astrocs.v6.signal/v1", "x-astrocs": { "anchor": "宪章 §4.1; UNIFIED §3", "domain": "Phase1/2/3 全部 signal 平面" } },
    "schema_version": { "const": 1, "x-astrocs": { "anchor": "宪章 §4.3", "domain": "全部" } },
    "physical_quantity": { "const": "signal", "x-astrocs": { "anchor": "宪章 §4.1; UNIFIED §3", "domain": "全部" } },
    "product_family": {
      "enum": ["phase1_drizzle_surface_brightness", "phase2_mosaic_surface_brightness", "phase2_mosaic_per_pixel_flux", "phase3_plane_surface_brightness", "phase3_plane_flux"],
      "x-astrocs": { "anchor": "DESIGN-P2 §9; DESIGN-P3 §1; FZ-P3-MODES", "domain": "Phase1/2/3 产品族", "fail_closed": "product_family 未声明或与输出模式矛盾 -> REJECT", "gate": "G-SIGNAL-FAMILY" }
    },
    "units": {
      "type": "string",
      "enum": ["ADU/px^2", "ADU", "BUNIT(声明)"],
      "x-astrocs": { "anchor": "FZ-UNIT-SIGNAL-SB; FZ-UNIT-FLUX; ADJ-GEN-01", "domain": "全部", "fail_closed": "units 缺失或非可判量纲 -> unavailable/REJECT(FZ-BUNIT-SEMANTICS)", "gate": "G-UNITS-JUDGEABLE" }
    },
    "pixel_semantics": {
      "enum": ["surface_brightness", "integrated_flux"],
      "x-astrocs": { "anchor": "ADJ-F-OBS-01; FZ-BUNIT-SEMANTICS", "domain": "全部", "fail_closed": "BUNIT=ADU 且 pixel_semantics 缺失 -> 单位不可判 REJECT", "gate": "G-BUNIT-SEMANTICS" }
    },
    "pixel_area_power": {
      "type": "integer",
      "x-astrocs": { "anchor": "FZ-BUNIT-SEMANTICS; astrocs.v6.units.v1 bunit_semantics.pixel_area_power_defaults", "domain": "全部", "fail_closed": "surface_brightness signal 要求 -2；flux 要求 0；不符即 REJECT", "gate": "G-PIXEL-AREA-POWER" }
    },
    "formula_ref": {
      "const": "S_p = Sum_j B_j a_jp / Sum_j a_jp, B_j = x_j/A_pixel,j",
      "x-astrocs": { "anchor": "FZ-FORMULA-DRIZZLE-SB; DESIGN-P1 §9:120-126; UNIFIED §7", "domain": "Phase1 Drizzle signal", "fail_closed": "归一版本为 legacy A_drop 时须显式声明归一版本并禁止用于绝对面亮度(pf<1)", "gate": "G-DRIZZLE-SB-NORM" }
    },
    "constant_field_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construction", "invariant", "tolerance_ref"],
      "properties": {
        "construction": { "const": "x_j = B0 * A_pixel_j (按面亮度 B0 构造)" },
        "invariant": { "const": "S_p = B0 for all pixfrac in (0,1]" },
        "tolerance_ref": { "const": "|S_p/B0 - 1| < 1e-3 (沿用, 不自行改容差)" }
      },
      "x-astrocs": { "anchor": "FZ-GATE-CONST-SB; ADJ-S3; p1drz_oracle.hpp:124-127", "domain": "Drizzle 验收", "fail_closed": "常量 ADU 构造 / 无条件 pixfrac 声明 / S_p=F_p 三错法必须使门变红", "gate": "G-CONST-SB-ORACLE" }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "pixfrac", "flux_conservation_factor"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "x-astrocs": { "anchor": "SC-ADJ-F02; ADJ-GEN-03", "domain": "Phase1" } },
        "kind": { "enum": ["surface_brightness_preserving", "legacy_adrop_forward", "column_normalized_flux"], "x-astrocs": { "anchor": "ADJ-F-OBS-02", "domain": "Phase1", "fail_closed": "legacy_adrop_forward 产品禁用于绝对面亮度且必须带归一版本", "gate": "G-NORM-VERSION" } },
        "pixfrac": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "x-astrocs": { "anchor": "DRIZZLE.md; ADJ-F-OBS-02", "domain": "Phase1" } },
        "flux_conservation_factor": { "type": "number", "exclusiveMinimum": 0, "x-astrocs": { "anchor": "FZ-COND-FLUX-CONSERV", "domain": "Phase1 flux 换算/aperture", "fail_closed": "pixfrac<1 且缺 flux_conservation_factor -> 不可用于绝对通量", "gate": "G-FLUX-CONSERV-FACTOR" } }
      }
    },
    "representation": {
      "enum": ["map", "model", "control_points", "scalar"],
      "x-astrocs": { "anchor": "UNIFIED §8; DESIGN-P1 §8.3; FZ-DEGRADE-SCALAR", "domain": "Phase1/2", "fail_closed": "scalar 必须过空间残差/趋势门 + 功率损失门并带 p05/p50/p95 等摘要；否则 REJECT", "gate": "G-DEGRADE-SCALAR" }
    },
    "dtype": { "enum": ["float32", "float64"], "x-astrocs": { "anchor": "宪章 §5.3; DATA_SEMANTICS §6", "domain": "全部" } },
    "invalid_policy": {
      "const": "nan_or_support_le_0",
      "x-astrocs": { "anchor": "DATA_SEMANTICS §4/§30.4; DESIGN-P3 §3", "domain": "全部", "fail_closed": "coverage=0 或输入 NaN 必须输出 NaN 并记录 provenance，不得 0 填充", "gate": "G-INVALID-NAN" }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p05", "p50", "p95", "max_systematic_deviation", "sampling_coverage", "model_error", "domain", "gates"],
      "properties": {
        "p05": { "type": "number" }, "p50": { "type": "number" }, "p95": { "type": "number" },
        "max_systematic_deviation": { "type": "number", "minimum": 0 },
        "sampling_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "model_error": { "type": "number", "minimum": 0 },
        "domain": { "type": "string", "minLength": 1 },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spatial_residual_gate", "power_loss_gate"],
          "properties": {
            "spatial_residual_gate": { "type": "string", "enum": ["pass", "fail"] },
            "power_loss_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["flux_bias_loss", "variance_loss", "detection_power_loss", "threshold_ref"],
              "properties": {
                "flux_bias_loss": { "type": "number", "minimum": 0 },
                "variance_loss": { "type": "number", "minimum": 0 },
                "detection_power_loss": { "type": "number", "minimum": 0 },
                "threshold_ref": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "x-astrocs": { "anchor": "FZ-DEGRADE-SCALAR; ADJ-GEN-04", "domain": "仅 representation=scalar 时", "fail_closed": "任一 required 缺失 -> REJECT", "gate": "G-DEGRADE-SCALAR" }
    },
    "provenance_ref": { "type": "string", "minLength": 1, "x-astrocs": { "anchor": "FZ-PROV-MINIMAL-SET; 宪章 §4.3", "domain": "全部" } }
  }
}
