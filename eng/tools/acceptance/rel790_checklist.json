{
  "schema": "acsd.rel790_checklist.v1",
  "note": "REL-790 成品帧视觉验收的证据包清单。两类记录：(A) input_frame 逐输入帧判定记录；(B) visual_panel 逐可视图块目检记录。清单只规定必须看什么/必须记什么，不改任何冻结阈值、不代替负责人目检。",
  "authority": {
    "visual_items": "ACCEPTANCE_SPEC.md §6.2 视觉验收清单（六项）",
    "product_chain": "ACCEPTANCE_SPEC.md §6.1（normalize -> mosaic -> export -> 拉伸 PNG -> 切块 PNG）",
    "publish_gate": "ACCEPTANCE_SPEC.md §6.3 / §8（发布预览版门；发布权 = docs/ACSD_DESIGN.md §13）",
    "control_pack_task": "run/FINAL-07/pkg/tasks/REL-790_目视验收收口.md",
    "seam_machine_gate": "ACCEPTANCE_SPEC.md §6.2 无接缝行（机器门 CHK-L4-SEAM-FOOTPRINT，阈值唯一数值源 = eng/tools/e2e/seam_footprint.py）",
    "tier_record": "docs/engineering/TIER_VERDICT_CRITERIA.md（档位判词记录；本清单的拒绝字段与它同源）"
  },
  "scope": {
    "filters": "R 通道 only（本版）",
    "datasets": [
      {
        "key": "m42",
        "title": "M42 T2+T3 Red（猎户座大星云）",
        "root": "testdata/M42_T2T3_mosaic_Flying_dutchman",
        "declared_frames": 49,
        "denominator": "declared_frames（计划帧 = 实际入册 Red 帧数，禁止用『抽样帧』作分母）",
        "inspects": "亮星云、高动态范围、密集星场"
      },
      {
        "key": "gc",
        "title": "Galaxy Center T4 Red（银心）",
        "root": "testdata/Galaxy_Center_T4",
        "declared_frames": 32,
        "denominator": "declared_frames",
        "inspects": "极密集星场、背景结构、大尺度马赛克"
      }
    ]
  },
  "required_fields_input_frame": [
    {
      "field": "frame_id",
      "type": "string",
      "why": "逐帧可对账"
    },
    {
      "field": "verdict",
      "type": "enum ACCEPT|REJECT|NOT_EVALUATED",
      "why": "帧级判词"
    },
    {
      "field": "n_pairs",
      "type": "int|null",
      "why": "WCS 内点数（冻结门 n_pairs<12 的分母侧读数）"
    },
    {
      "field": "rms_px",
      "type": "number|null",
      "why": "WCS 拟合残差（冻结门 rms_px>0.5 的分母侧读数）"
    },
    {
      "field": "rejection",
      "type": "object|null",
      "why": "拒绝块；verdict=REJECT 时必填"
    },
    {
      "field": "evidence",
      "type": "array",
      "why": "逐帧日志/侧车/单帧运行记录；run/ 下必须带 sha256"
    }
  ],
  "required_fields_rejection": [
    {
      "field": "gate_id",
      "type": "string",
      "why": "触发的门（须能在 frozen_gate_inventory.json 里查到）"
    },
    {
      "field": "reason",
      "type": "string",
      "why": "逐字引产品日志的拒绝行（不得转述）"
    },
    {
      "field": "classification",
      "type": "enum product_behavior|defect",
      "why": "拒绝是产品行为还是缺陷；unknown 不接受"
    },
    {
      "field": "exit",
      "type": "enum stop_work|registered",
      "why": "停工还是登记流程"
    },
    {
      "field": "deterministic_replay",
      "type": "bool",
      "why": "重跑逐位复现（决定它是不是偶发）"
    }
  ],
  "required_fields_visual_panel": [
    {
      "field": "panel_id",
      "type": "string",
      "why": "图块/整幅编号"
    },
    {
      "field": "kind",
      "type": "enum full|tile",
      "why": "整幅还是切块"
    },
    {
      "field": "image",
      "type": "object(path, sha256)",
      "why": "PNG 路径 + 内容指纹"
    },
    {
      "field": "inspector",
      "type": "string",
      "why": "谁看的（agent 初审 or 验收方）"
    },
    {
      "field": "items",
      "type": "object（六项逐项判词）",
      "why": "ACCEPTANCE_SPEC §6.2 六项逐项"
    },
    {
      "field": "zoom_note",
      "type": "string|null",
      "why": "有疑问区域是否裁剪放大后再读（ACCEPTANCE_SPEC §6.1 末条）"
    },
    {
      "field": "reject_reason",
      "type": "string|null",
      "why": "任一项不合格时的原因（须分类 product_behavior/defect）"
    }
  ],
  "visual_items": [
    {
      "key": "no_black_hole",
      "text": "无黑洞：无异常零值/死区/未填充孔洞；稀疏区与重叠区过渡自然"
    },
    {
      "key": "no_bright_spot",
      "text": "无亮斑：无宇宙线/卫星线残留、校准伪影、饱和溢出异常亮点"
    },
    {
      "key": "no_seam",
      "text": "无接缝：帧间/块间无亮度阶跃、无重影错位重复星点（并附机器门逐边度量）"
    },
    {
      "key": "star_quality",
      "text": "星点质量：圆锐、无拖尾/拉伸/双线，跨帧重合"
    },
    {
      "key": "background_geometry",
      "text": "背景与几何：背景均匀、天光结构连续、无明显投影畸变、WCS 网格吻合"
    },
    {
      "key": "global_impression",
      "text": "全局观感：天区结构正确、灰度/动态范围自然"
    }
  ],
  "pack_level_required": [
    {
      "field": "pack_id",
      "why": "证据包标识"
    },
    {
      "field": "dataset",
      "why": "本次提交的天区（m42 / gc）"
    },
    {
      "field": "binary_and_profile",
      "why": "二进制 + HEAD + CPU 画像 source_commit（三者同二进制性）"
    },
    {
      "field": "seam_machine_metrics",
      "why": "接缝机器门逐边度量 JSON（rel_step + exclude + margin_px）"
    },
    {
      "field": "coverage_metrics",
      "why": "covered_px/total_px/finite_fraction（覆盖度分母）"
    },
    {
      "field": "stage_logs",
      "why": "三阶段日志与资源记录"
    },
    {
      "field": "tier_verdict_record",
      "why": "本批对应的档位判词记录（tier_verdict_gate.py 判绿）"
    }
  ],
