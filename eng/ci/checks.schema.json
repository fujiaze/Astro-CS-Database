{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profiles",
          "platform",
          "command",
          "timeout_seconds",
          "heavy",
          "mutates_workspace",
          "outputs",
          "waivable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_.-]+$"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "fast",
                "integration",
                "linux-main",
                "linux-deep",
                "windows-main",
                "prerelease",
                "fatduck"
              ]
            }
          },
          "platform": {
            "enum": [
              "any",
              "linux",
              "windows",
              "fatduck"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "heavy": {
            "type": "boolean"
          },
          "mutates_workspace": {
            "type": "boolean"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "waivable": {
            "type": "boolean"
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_monitor": {
            "type": "boolean"
          },
          "prerequisite_tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "可选：命令依赖的外部工具名（如 eng/cmake/clang/pytest），缺失时检查跳过（waivable）或 FAIL(prerequisite)；CI-REG-002/STD-F10 扩展 <exe>:<module> 形式表示 Python 模块依赖（如 python3:astropy），探测实现见 eng/ci/run.py probe_prerequisite"
          },
          "ctest_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "CI-REG-002：本检查显式登记的 CTest 目标名（精确名或 shell glob）。eng/tools/quality/check_ctest_registration.py 以此判定 add_test 目标的注册闭包——每个 add_test 目标必须被某检查项的 ctest_targets 命中，或登记在 eng/ci/ctest_baseline.json 冻结存量清单中"
          },
          "dirty_ignore_exact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dirty_ignore_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reads_run_results": {
            "type": "boolean",
            "description": "CI-INCREMENTAL：该执行单元读取同 run 其它 step 的 per-step 结果（聚合门）⇒ 调度器必须把它排在最后串行执行，不得与其它 step 并发"
          },
          "fingerprint": {
            "type": "object",
            "description": "CI_SPEC.md §2.6 输入指纹缓存（重步骤只跑一次）：commit + 相关配置 SHA256 + 数据清单 SHA256 + worker 数命中 ⇒ 复用归档并打印 reused_fingerprint；归档证据缺失时照常执行（fail-closed，不以复用为名跳过判定）",
            "required": [
              "archive"
            ],
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "config": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "workers": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "extra": {
                "type": "object"
              },
              "archive": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "description": "CI-001 ID 收敛：聚合项的逐条子检查（step）。每个 step 是自描述最小检查单元，旧注册 ID 原样保留为 step.id；执行器（eng/ci/run_checks.py / eng/ci/run.py 派发）逐 step 按自身 timeout 执行。单步且 id 与父项相同时可省略 steps（旧式单项注册）",
            "items": {
              "type": "object",
              "required": [
                "id",
                "command",
                "timeout_seconds",
                "profiles",
                "platform"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9_.-]+$"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "profiles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "fast",
                      "integration",
                      "linux-main",
                      "linux-deep",
                      "windows-main",
                      "prerelease",
                      "fatduck"
                    ]
                  }
                },
                "platform": {
                  "enum": [
                    "any",
                    "linux",
                    "windows",
                    "fatduck"
                  ]
                },
                "heavy": {
                  "type": "boolean"
                },
                "mutates_workspace": {
                  "type": "boolean"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "waivable": {
                  "type": "boolean"
                },
                "changed_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requires_monitor": {
                  "type": "boolean"
                },
                "prerequisite_tools": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "ctest_targets": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "dirty_ignore_exact": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dirty_ignore_prefixes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reads_run_results": {
                  "type": "boolean"
                },
                "fingerprint": {
                  "type": "object",
                  "description": "CI_SPEC.md §2.6 输入指纹缓存（step 级，语义同顶层）",
                  "required": [
                    "archive"
                  ],
                  "properties": {
                    "commit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "config": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "workers": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "extra": {
                      "type": "object"
                    },
                    "archive": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
