{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "astrocs.scheduler-probe-event/v1",
  "title": "三阶段调度器探针事件（JSONL 单行）",
  "x-doc": "docs/contracts/SCHEDULER_CONTRACT.md",
  "type": "object",
  "required": [
    "ts",
    "stage",
    "kind",
    "value",
    "unit"
  ],
  "properties": {
    "ts": {
      "type": "number"
    },
    "stage": {
      "enum": [
        "normalize",
        "mosaic",
        "export"
      ]
    },
    "kind": {
      "enum": [
        "node_wall",
        "queue_wait",
        "block_birth",
        "block_death",
        "rss",
        "io",
        "worker_busy",
        "cache_hit"
      ]
    },
    "node": {
      "type": "string"
    },
    "block": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "s",
        "B",
        "1"
      ]
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "window_id": {
      "type": "integer",
      "minimum": 0
    },
    "worker": {
      "type": "integer",
      "minimum": 0
    }
  }
}
