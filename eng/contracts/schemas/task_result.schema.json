{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/task-result-v2.json",
  "title": "AstroCS V6.1 Task Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "status", "parent_commit", "control_sha256", "ledger_sha256", "change_class", "changed_paths", "impact", "commands", "tests", "evidence", "findings", "expected_commit_subject", "created_utc"],
  "properties": {
    "schema": {"const": "astrocs.task-result/v2"},
    "task_id": {"type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3}$"},
    "status": {"enum": ["PASS", "FAIL", "WAITING_WINDOWS"]},
    "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_class": {"enum": ["governance", "audit", "release", "quality", "architecture", "science", "algorithm", "api", "performance", "test", "documentation", "validation"]},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"}},
    "impact": {
      "type": "object", "additionalProperties": false,
      "required": ["science", "algorithm", "data_semantics", "public_api", "pipeline", "binary", "reason"],
      "properties": {
        "science": {"type": "boolean"}, "algorithm": {"type": "boolean"}, "data_semantics": {"type": "boolean"},
        "public_api": {"type": "boolean"}, "pipeline": {"type": "boolean"}, "binary": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 3}
      }
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["command_id", "argv_redacted", "timeout_seconds", "exit_code", "started_utc", "duration_seconds", "log_path", "log_sha256"], "properties": {
        "command_id": {"type": "string", "minLength": 1}, "argv_redacted": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1}, "exit_code": {"type": "integer"}, "started_utc": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "number", "minimum": 0}, "log_path": {"type": "string"}, "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }}
    },
    "tests": {"type": "array", "items": {"type": "object", "required": ["test_id", "result", "evidence_sha256"], "properties": {"test_id": {"type": "string"}, "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "findings": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{3}$"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "expected_commit_subject": {"type": "string", "minLength": 8},
    "created_utc": {"type": "string", "format": "date-time"}
  }
}
