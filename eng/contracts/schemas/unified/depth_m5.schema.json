{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/unified/depth_m5/v1",
  "title": "ACSD 统一对象 depth_m5 —— 固定参考 PSF/孔径下 5σ 深度",
  "description": "UNIFIED_MODEL §2：depth_m5 = 固定参考 PSF/孔径下 5σ 深度；可否作权重 = 摘要，不作权重。depth_m5 是摘要量，禁止当作 frame_snr 或权重使用。",
  "x-astrocs-object": {
    "name": "depth_m5",
    "canonical_file": "eng/contracts/schemas/unified/depth_m5.schema.json",
    "authority": "docs/design/UNIFIED_MODEL.md §2；ASTROCS_DESIGN.md §2；ENGINEERING_SPEC.md §3/§4.7",
    "weight_verdict": "摘要，不作权重",
    "weight_eligible": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unified_object",
    "object_schema_id",
    "schema_version",
    "units",
    "missing_value",
    "precision",
    "object_weight_capability",
    "object_weight_verdict",
    "provenance",
    "depth_value",
    "reference_aperture",
    "reference_psf",
    "sigma_level",
    "role"
  ],
  "propertyNames": {
    "pattern": "^(?!(weight|value|mask|snr)$)(?!(weight|value|mask|snr)(_|$))(?!(weight|value|mask)(_|$)).*$",
    "not": {
      "enum": [
        "ivar",
        "inverse_variance",
        "variance",
        "var",
        "sigma",
        "sigma2",
        "fisher",
        "fisher_information",
        "information",
        "w_info",
        "w_psf",
        "snr",
        "snr2",
        "support",
        "coverage"
      ],
      "description": "禁止键守卫（FZ-FIELD-PSFSW-4COMP / FZ-GATE-PSFSW-COV）：诊断量/派生量不得作为裸键出现，禁止写成 ivar/Fisher/W_info/方差/SNR/support/coverage 等；见 docs/contracts/DATA_SEMANTICS.md §31.7/§31.8"
    }
  },
  "properties": {
    "unified_object": {
      "const": "depth_m5",
      "description": "对象判别式：本文档声明的 UNIFIED_MODEL §2 对象名（禁止用别的对象名冒充）"
    },
    "object_schema_id": {
      "const": "https://astrocs.local/schemas/unified/depth_m5/v1",
      "description": "全局唯一 schema ID（eng/contracts/schemas/unified/depth_m5.schema.json）"
    },
    "schema_version": {
      "const": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bunit",
        "bunit_semantics",
        "pixel_semantics",
        "pixel_area_power"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "bunit": {
          "const": "mag",
          "description": "5σ 深度以星等（mag）表达"
        },
        "bunit_semantics": {
          "description": "FZ-BUNIT-SEMANTICS：written_px_power = BUNIT 显式含立体角幂次（canonical \"sr\"）；declared_via_provenance = BUNIT 仅写 ADU 时必须由 provenance 声明 pixel_semantics + pixel_area_power",
          "enum": [
            "written_px_power",
            "declared_via_provenance"
          ]
        },
        "pixel_semantics": {
          "description": "像素语义（BUNIT=ADU 时唯一可判依据）",
          "enum": [
            "surface_brightness",
            "integrated_flux",
            "dimensionless",
            "count",
            "probability",
            "magnitude"
          ]
        },
        "pixel_area_power": {
          "description": "立体角幂次：面亮度 -2 / 通量 0（FZ-BUNIT-SEMANTICS 缺省表；-2 ⇔ canonical 串含 /sr）",
          "enum": [
            -2,
            0
          ]
        },
        "target_pixel_area": {
          "description": "目标像素面积（BUNIT=ADU 且 surface_brightness 时必需）",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bunit": {
                "pattern": "/sr"
              }
            },
            "required": [
              "bunit"
            ]
          },
          "then": {
            "properties": {
              "bunit_semantics": {
                "const": "written_px_power"
              },
              "pixel_semantics": {
                "const": "surface_brightness"
              },
              "pixel_area_power": {
                "const": -2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bunit_semantics": {
                "const": "declared_via_provenance"
              }
            },
            "required": [
              "bunit_semantics"
            ]
          },
          "then": {
            "required": [
              "target_pixel_area"
            ],
            "properties": {
              "pixel_semantics": {
                "const": "surface_brightness"
              },
              "pixel_area_power": {
                "const": -2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pixel_semantics": {
                "const": "integrated_flux"
              }
            },
            "required": [
              "pixel_semantics"
            ]
          },
          "then": {
            "properties": {
              "pixel_area_power": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "missing_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_repr",
        "invalid_repr"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "missing_repr": {
          "description": "缺失表示（对象文档不得省略该声明）",
          "enum": [
            "null",
            "absent_key",
            "zero",
            "null_or_absent",
            "unavailable_object"
          ]
        },
        "invalid_repr": {
          "description": "无效值表示",
          "enum": [
            "null",
            "nan",
            "zero",
            "nan_or_negative",
            "mask_bit",
            "unavailable_object",
            "not_applicable"
          ]
        },
        "nan_in_binary": {
          "description": "二进制平面是否允许 NaN 承载 invalid（JSON 无 NaN 字面量）",
          "type": "boolean"
        },
        "silent_zero_forbidden": {
          "description": "禁止用 0 冒充缺失/不可用（静默 0 = fail-closed）",
          "type": "boolean"
        },
        "sentinel_note": {
          "description": "补充说明（不得引入第二套无效值口径）",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "precision": {
      "description": "精度：float32 / float64 / integer（与 DATA_SEMANTICS §6 一致，不得自定第二套）",
      "enum": [
        "float32",
        "float64",
        "integer"
      ]
    },
    "object_weight_capability": {
      "const": false,
      "description": "UNIFIED_MODEL §2「可否作权重」列的机器判定（照抄，不得自行改判定）"
    },
    "object_weight_verdict": {
      "const": "摘要，不作权重",
      "description": "UNIFIED_MODEL §2「可否作权重」列原文（逐字）"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_chain"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "source_chain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "description": "上游产品/输入标识（产物引用，悬空即 REJECT）",
            "type": "string",
            "minLength": 1
          },
          "description": "来源链：本对象由哪些上游产物/输入派生（FZ-PROV-MINIMAL-SET 的对象级最小集）"
        },
        "software_sha": {
          "description": "生成该对象的软件完整 SHA（40 hex）",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "config_hash": {
          "description": "配置哈希（run_manifest.config_hash）",
          "type": "string",
          "minLength": 1
        },
        "algorithm_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "description": "算法条款 ID（ALG-* / SCI-*）",
            "type": "string",
            "minLength": 1
          }
        },
        "generated_utc": {
          "description": "生成时间 UTC（ISO-8601，Z 结尾）",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "depth_value": {
      "description": "5σ 深度数值（星等；越小越深）",
      "type": "number"
    },
    "reference_aperture": {
      "description": "固定参考孔径（px；与参考 PSF 一并声明）",
      "type": "string",
      "minLength": 1
    },
    "reference_psf": {
      "description": "固定参考 PSF（FWHM/模型标识）",
      "type": "string",
      "minLength": 1
    },
    "sigma_level": {
      "const": 5.0,
      "description": "5σ 深度定义的 σ 倍数（冻结为 5）"
    },
    "role": {
      "description": "角色：摘要",
      "enum": [
        "summary"
      ]
    }
  }
}
