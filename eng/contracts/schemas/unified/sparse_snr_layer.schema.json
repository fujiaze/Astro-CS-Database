{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/unified/sparse_snr_layer/v1",
  "title": "AstroCS 统一对象 sparse_snr_layer —— 帧内稀疏控制点绝对 SNR 参考（可选标准层）",
  "description": "UNIFIED_MODEL §2：sparse_snr_layer = 帧内稀疏控制点上的**绝对** SNR 参考（可选标准层）；控制点值 = 该点的通量型信噪比 F_ref/sigma_F(x,y)（与 frame_snr 同物理定义、同逐帧参考通量 F_ref，无量纲），Phase2 由控制点**直接重建**为稠密 SNR 场，权重逐像素换算 w(x,y)=SNR(x,y)^2/F_ref^2；可否作权重 = 帧内精细参考。该层是参考层，不是 variance/ivar，不承载帧级权重；与 frame_snr 相互独立（frame_snr 不作本层的尺度基准）。",
  "x-astrocs-object": {
    "name": "sparse_snr_layer",
    "canonical_file": "eng/contracts/schemas/unified/sparse_snr_layer.schema.json",
    "authority": "docs/design/UNIFIED_MODEL.md §2；ASTROCS_DESIGN.md §2；ENGINEERING_SPEC.md §3/§4.7",
    "weight_verdict": "帧内精细参考",
    "weight_eligible": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unified_object",
    "object_schema_id",
    "schema_version",
    "units",
    "missing_value",
    "precision",
    "object_weight_capability",
    "object_weight_verdict",
    "provenance",
    "sparse_snr_semantics",
    "control_points",
    "frame_id",
    "role"
  ],
  "propertyNames": {
    "pattern": "^(?!(weight|value|mask|snr)$)(?!(weight|value|mask|snr)(_|$))(?!(weight|value|mask)(_|$)).*$",
    "not": {
      "enum": [
        "ivar",
        "inverse_variance",
        "variance",
        "var",
        "sigma",
        "sigma2",
        "fisher",
        "fisher_information",
        "information",
        "w_info",
        "w_psf",
        "snr",
        "snr2",
        "support",
        "coverage"
      ],
      "description": "禁止键守卫（FZ-FIELD-PSFSW-4COMP / FZ-GATE-PSFSW-COV）：诊断量/派生量不得作为裸键出现，禁止写成 ivar/Fisher/W_info/方差/SNR/support/coverage 等；见 docs/contracts/DATA_SEMANTICS.md §31.7/§31.8"
    }
  },
  "properties": {
    "unified_object": {
      "const": "sparse_snr_layer",
      "description": "对象判别式：本文档声明的 UNIFIED_MODEL §2 对象名（禁止用别的对象名冒充）"
    },
    "object_schema_id": {
      "const": "https://astrocs.local/schemas/unified/sparse_snr_layer/v1",
      "description": "全局唯一 schema ID（eng/contracts/schemas/unified/sparse_snr_layer.schema.json）"
    },
    "schema_version": {
      "const": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bunit",
        "bunit_semantics",
        "pixel_semantics",
        "pixel_area_power"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "bunit": {
          "description": "FITS BUNIT 写盘串（量纲必须可判：含 px 幂次，或由 bunit_semantics 显式声明）",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_^/(). -]*$"
        },
        "bunit_semantics": {
          "description": "FZ-BUNIT-SEMANTICS：written_px_power = BUNIT 显式含 px 幂次；declared_via_provenance = BUNIT 仅写 ADU 时必须由 provenance 声明 pixel_semantics + pixel_area_power",
          "enum": [
            "written_px_power",
            "declared_via_provenance"
          ]
        },
        "pixel_semantics": {
          "description": "像素语义（BUNIT=ADU 时唯一可判依据）",
          "enum": [
            "surface_brightness",
            "integrated_flux",
            "dimensionless",
            "count",
            "probability",
            "magnitude"
          ]
        },
        "pixel_area_power": {
          "description": "px 幂次：面亮度 -2 / 通量 0（FZ-BUNIT-SEMANTICS 缺省表）",
          "enum": [
            -2,
            0
          ]
        },
        "target_pixel_area": {
          "description": "目标像素面积（BUNIT=ADU 且 surface_brightness 时必需）",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bunit": {
                "pattern": "/px\\^2"
              }
            },
            "required": [
              "bunit"
            ]
          },
          "then": {
            "properties": {
              "bunit_semantics": {
                "const": "written_px_power"
              },
              "pixel_semantics": {
                "const": "surface_brightness"
              },
              "pixel_area_power": {
                "const": -2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bunit_semantics": {
                "const": "declared_via_provenance"
              }
            },
            "required": [
              "bunit_semantics"
            ]
          },
          "then": {
            "required": [
              "target_pixel_area"
            ],
            "properties": {
              "pixel_semantics": {
                "const": "surface_brightness"
              },
              "pixel_area_power": {
                "const": -2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pixel_semantics": {
                "const": "integrated_flux"
              }
            },
            "required": [
              "pixel_semantics"
            ]
          },
          "then": {
            "properties": {
              "pixel_area_power": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "missing_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_repr",
        "invalid_repr"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "missing_repr": {
          "description": "缺失表示（对象文档不得省略该声明）",
          "enum": [
            "null",
            "absent_key",
            "zero",
            "null_or_absent",
            "unavailable_object"
          ]
        },
        "invalid_repr": {
          "description": "无效值表示",
          "enum": [
            "null",
            "nan",
            "zero",
            "nan_or_negative",
            "mask_bit",
            "unavailable_object",
            "not_applicable"
          ]
        },
        "nan_in_binary": {
          "description": "二进制平面是否允许 NaN 承载 invalid（JSON 无 NaN 字面量）",
          "type": "boolean"
        },
        "silent_zero_forbidden": {
          "description": "禁止用 0 冒充缺失/不可用（静默 0 = fail-closed）",
          "type": "boolean"
        },
        "sentinel_note": {
          "description": "补充说明（不得引入第二套无效值口径）",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "precision": {
      "description": "精度：float32 / float64 / integer（与 DATA_SEMANTICS §6 一致，不得自定第二套）",
      "enum": [
        "float32",
        "float64",
        "integer"
      ]
    },
    "object_weight_capability": {
      "const": false,
      "description": "UNIFIED_MODEL §2「可否作权重」列的机器判定（照抄，不得自行改判定）"
    },
    "object_weight_verdict": {
      "const": "帧内精细参考",
      "description": "UNIFIED_MODEL §2「可否作权重」列原文（逐字）"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_chain"
      ],
      "propertyNames": {
        "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
      },
      "properties": {
        "source_chain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "description": "上游产品/输入标识（产物引用，悬空即 REJECT）",
            "type": "string",
            "minLength": 1
          },
          "description": "来源链：本对象由哪些上游产物/输入派生（FZ-PROV-MINIMAL-SET 的对象级最小集）"
        },
        "software_sha": {
          "description": "生成该对象的软件完整 SHA（40 hex）",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "config_hash": {
          "description": "配置哈希（run_manifest.config_hash）",
          "type": "string",
          "minLength": 1
        },
        "algorithm_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "description": "算法条款 ID（ALG-* / SCI-*）",
            "type": "string",
            "minLength": 1
          }
        },
        "generated_utc": {
          "description": "生成时间 UTC（ISO-8601，Z 结尾）",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "sparse_snr_semantics": {
      "const": "absolute_flux_type_snr",
      "description": "控制点值的数值语义判别式（冻结）：absolute_flux_type_snr = 绝对通量型未加权信噪比 SNR_c = F_ref/sigma_F,c（与 frame_snr 同口径、同逐帧参考通量 F_ref）。该层**不**存相对因子、**不**按中位归一、**不**以帧级 SNR 为尺度基准；消费时不得乘/除帧级 SNR 做还原。声明为任何相对语义 ⇒ schema 判红。"
    },
    "control_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "sparse_snr_value"
        ],
        "propertyNames": {
          "pattern": "^(?!(weight|value|mask|snr|snr_value|weight_value|value_value|mask_value)$).*$"
        },
        "properties": {
          "x": {
            "description": "控制点 x（像素坐标）",
            "type": "number"
          },
          "y": {
            "description": "控制点 y（像素坐标）",
            "type": "number"
          },
          "sparse_snr_value": {
            "description": "控制点**绝对**通量型 SNR 值 = F_ref/sigma_F,c（无量纲，与 frame_snr 同物理口径、同逐帧参考通量 F_ref；非相对因子，不得再乘帧级标量）。量纲/值域：无量纲比值，(0, +inf) 开区间——0 与负值不是合法 SNR；无效值语义见 missing_value（二进制面用 NaN 承载 invalid，与 signal 的 NaN 同态；禁 0 冒充缺失）。",
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "description": "帧内稀疏控制点列表；每点的 sparse_snr_value 是该点的**绝对** SNR（不是相对因子）。控制点值与帧级 frame_snr 使用同一逐帧参考通量 F_ref（同一帧的 frame_snr.reference_baseline）。"
    },
    "frame_id": {
      "description": "帧标识",
      "type": "string",
      "minLength": 1
    },
    "density": {
      "description": "控制点密度（px^-2；无权威数值时须显式 pending_authority）",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pending_authority": {
      "description": "无权威数值时的占位登记（归属任务；禁止编造数值）",
      "type": "string",
      "minLength": 1
    },
    "role": {
      "description": "角色：帧内精细参考",
      "enum": [
        "intra_frame_reference"
      ]
    }
  }
}
