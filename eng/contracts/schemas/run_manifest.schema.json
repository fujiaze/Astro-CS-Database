{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocs.local/schemas/run_manifest/v1",
  "title": "AstroCS run_manifest v1",
  "description": "CFG-001 建立的运行冻结合同：源码 SHA / 配置哈希 / 输入输出哈希 / 工具链版本。不承载科学参数，也不承载硬件调优字段。",
  "x-astrocs-schema-family": "run_manifest",
  "x-astrocs-config-class": "run_manifest",
  "x-astrocs-writer": "运行时（每次运行冻结）",
  "x-astrocs-not-writable-by": [
    "用户",
    "benchmark"
  ],
  "x-astrocs-authority": [
    "docs/design/UNIFIED_MODEL.md §3（run_manifest：本次运行冻结：源码/配置/输入输出哈希）",
    "docs/contracts/config_separation_anchors.json（run_manifest 字段名族与禁止名）",
    "ASTROCS_DESIGN.md §6.3:322（运行事件与机器输出）"
  ],
  "x-astrocs-notes": [
    "字段名取自 DATA-001 锚点 config_separation_anchors.json 的 run_manifest 族：^run_id$ / ^software_sha$ / ^config_hash$ / ^manifest_(input|output)_hashes$ / ^toolchain_[a-z0-9_]+$。",
    "禁止名（锚点 config_classes[run_manifest].forbidden_field_names）：isa / workers / block / sci_algorithm_id / sci_weight_mode。哈希一律小写十六进制，长度固定。"
  ],
  "type": "object",
  "required": [
    "manifest_schema",
    "run_id",
    "software_sha",
    "config_hash",
    "manifest_input_hashes",
    "manifest_output_hashes",
    "toolchain_version",
    "created_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_schema": {
      "const": "astrocs.run-manifest/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "本次运行标识（唯一）"
    },
    "software_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "冻结的源码 git commit SHA（40hex；与 cpu_profile v2 build.source_commit 同口径）"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "phase_config 的 sha256（64hex）"
    },
    "manifest_input_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "manifest_output_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "toolchain_version": {
      "type": "string",
      "minLength": 1,
      "description": "工具链版本（编译器/CMake/依赖；锚点族 ^toolchain_[a-z0-9_]+$）"
    },
    "toolchain_compiler": {
      "type": "string",
      "minLength": 1
    },
    "toolchain_cmake": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
