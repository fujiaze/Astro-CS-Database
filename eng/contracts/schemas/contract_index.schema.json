{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acsd.local/schemas/contract-index-v1.json",
  "title": "ACSD Contract Index v1",
  "description": "合同 ID 注册表约束: 唯一 ID, owner, version, status, links, 无悬空引用；legacy_contract_id_map 登记旧合同 ID 到统一对象 canonical 的映射。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "contracts"],
  "properties": {
    "schema": { "const": "acsd.contract-index/v1" },
    "version": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "status", "owner", "version", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^(SCI|ALG|DATA|ARCH|API|MOD|TEST|TST)-[A-Z0-9-]+$" },
          "type": { "enum": ["SCI", "ALG", "DATA", "ARCH", "API", "MOD", "TEST"] },
          "status": { "enum": ["ACTIVE", "DRAFT", "OBSOLETE", "CONFLICT", "DORMANT"] },
          "owner": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "upstream": { "type": "array", "items": { "type": "string" } },
          "downstream": { "type": "array", "items": { "type": "string" } }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "OBSOLETE" } }, "required": ["status"] },
            "then": {},
            "else": { "properties": { "path": { "minLength": 1 } } }
          }
        ]
      }
    },
    "legacy_contract_id_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["legacy_id", "decision", "canonical_objects", "relation", "canonical_schema_files"],
        "properties": {
          "legacy_id": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["mapped", "no_canonical"] },
          "canonical_objects": { "type": "array", "items": { "type": "string" } },
          "relation": { "type": "string", "minLength": 1 },
          "canonical_schema_files": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
