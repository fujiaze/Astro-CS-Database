{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "astrocs:schemas/jsonl_event_v1.schema.json",
  "title": "ACSD JSONL event v1 (API-CLI-001 / 04 §4 frozen — CLI-004)",
  "description": "docs/api/CLI_PROTOCOL_V1.md §4 权威: --events-jsonl 每行一个事件; 10 必含字段 + kind 冻结扩展字段; sequence 从 0 单调递增。GUI/外部 harness 只消费本协议面。kind 面 = 10 类开放 kind 全登记（FIX-405 G3-10）：properties.kind.enum 是封闭注册表，enum 之外一律拒（发送侧 ValidateEventV1 同面硬闸）。实现正本 = lib/infrastructure/cli/protocol.h registered_event_kinds_v1()。",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "timestamp_utc",
    "sequence",
    "kind",
    "severity",
    "phase",
    "stage",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "event_id": {
      "type": "string",
      "description": "evt-<run_id>-<sequence>",
      "pattern": "^evt-[0-9a-f]{12}-[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "timestamp_utc": {
      "type": "string",
      "description": "ISO-8601 UTC",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "description": "§4 kind 注册表（10 类，封闭枚举；实现正本 = lib/infrastructure/cli/protocol.h registered_event_kinds_v1()）。未登记 kind 被拒（enum 之外 ⇒ 本 schema 判红；发送侧 ValidateEventV1 拒发）。新增 kind 必须同时登记实现正本与本 enum（只增不改）。",
      "enum": [
        "progress",
        "resource",
        "artifact",
        "backend",
        "final",
        "stage_start",
        "stage_end",
        "graph",
        "resource_gate",
        "v6_mode_route"
      ]
    },
    "severity": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "completed": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "rate": {
      "type": [
        "number",
        "null"
      ]
    },
    "eta_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "cpu_cores_used": {
      "type": "number"
    },
    "rss_bytes": {
      "type": "number"
    },
    "io_read_bytes": {
      "type": "number"
    },
    "io_write_bytes": {
      "type": "number"
    },
    "threads": {
      "type": "number"
    },
    "role": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": [
        "number",
        "null"
      ]
    },
    "kernel": {
      "type": "string"
    },
    "backend_id": {
      "type": "string"
    },
    "isa": {
      "type": "string"
    },
    "workers": {
      "type": "number"
    },
    "block_size": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer",
      "description": "04 §2 冻结 11 条退出码域 (exit_codes.h 唯一源)",
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9,
        10,
        70
      ]
    },
    "status": {
      "type": "string"
    },
    "run_manifest": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "diag": {
      "type": "string"
    },
    "enforcement": {
      "type": "string"
    },
    "strict": {
      "type": "boolean"
    },
    "enforced": {
      "type": "boolean"
    },
    "work_core_seconds": {
      "type": "number"
    },
    "workload_floor_core_seconds": {
      "type": "number"
    },
    "workload_floor_reached": {
      "type": "boolean"
    },
    "route_kind": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "implicit_phase_chain": {
      "type": "boolean"
    },
    "budget_source_owner": {
      "type": "string"
    },
    "budget_allocated_cores": {
      "type": "number"
    },
    "one_budget_source_rule": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "final"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "exit_code",
          "status",
          "run_manifest",
          "summary"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "progress"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "completed",
          "total",
          "unit",
          "rate",
          "eta_seconds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "resource"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "cpu_cores_used",
          "rss_bytes",
          "io_read_bytes",
          "io_write_bytes",
          "threads"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "artifact"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "role",
          "path",
          "sha256",
          "size_bytes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "backend"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "kernel",
          "backend_id",
          "isa",
          "workers",
          "block_size",
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "stage_start"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "stage_end"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "graph"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "resource_gate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "diag",
          "enforcement",
          "strict",
          "enforced",
          "work_core_seconds",
          "workload_floor_core_seconds",
          "workload_floor_reached",
          "so05_signoff_id",
          "so05_signoff_status",
          "auto_adjudication_allowed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "v6_mode_route"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "route_kind",
          "token",
          "surface",
          "source",
          "reason",
          "implicit_phase_chain",
          "budget_source_owner",
          "budget_allocated_cores",
          "one_budget_source_rule"
        ]
      }
    }
  ],
  "x-astrocs-event-kind-registry": {
    "spec": "astrocs.event-kind-registry/v1",
    "implementation_authority": "lib/infrastructure/cli/protocol.h::registered_event_kinds_v1()",
    "human_contract": "docs/api/CLI_PROTOCOL_V1.md §4",
    "rule": "未登记 kind 被拒（enum 之外判红 + 发送侧拒发）；新增 kind 必须同时登记实现正本与本 enum（只增不改）",
    "kinds": {
      "progress": [
        "completed",
        "total",
        "unit",
        "rate",
        "eta_seconds"
      ],
      "resource": [
        "cpu_cores_used",
        "rss_bytes",
        "io_read_bytes",
        "io_write_bytes",
        "threads"
      ],
      "artifact": [
        "role",
        "path",
        "sha256",
        "size_bytes"
      ],
      "backend": [
        "kernel",
        "backend_id",
        "isa",
        "workers",
        "block_size",
        "reason"
      ],
      "final": [
        "exit_code",
        "status",
        "run_manifest",
        "summary"
      ],
      "stage_start": [],
      "stage_end": [],
      "graph": [
        "path"
      ],
      "resource_gate": [
        "diag",
        "enforcement",
        "strict",
        "enforced",
        "work_core_seconds",
        "workload_floor_core_seconds",
        "workload_floor_reached",
        "so05_signoff_id",
        "so05_signoff_status",
        "auto_adjudication_allowed"
      ],
      "v6_mode_route": [
        "route_kind",
        "token",
        "surface",
        "source",
        "reason",
        "implicit_phase_chain",
        "budget_source_owner",
        "budget_allocated_cores",
        "one_budget_source_rule"
      ]
    }
  },
  "additionalProperties": true
}
