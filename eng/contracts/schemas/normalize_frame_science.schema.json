{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acsd.local/schemas/normalize/frame_science/v1",
  "title": "Normalize per-frame scientific model and spherical reference precision",
  "description": "Design contract; production reader/writer integration is not yet implemented. Authority: docs/engineering/contracts/NORMALIZE_DATA.md. JSON shape does not validate cross-field physical identities or model file hashes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "acsd.normalize.frame-science/v1"
    },
    "schema_version": {
      "const": 1
    },
    "product_role": {
      "const": "normalize_frame"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "input_occurrence": {
      "type": "integer",
      "minimum": 0
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "software_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hips_path": {
          "$ref": "#/$defs/path"
        },
        "bunit": {
          "type": "string",
          "minLength": 1
        },
        "linear_unit": {
          "type": "string",
          "minLength": 1
        },
        "scale_state": {
          "enum": [
            "native_calibrated",
            "relative_scaled",
            "response_calibrated"
          ]
        },
        "ordering": {
          "const": "nested"
        },
        "leaf_order": {
          "type": "integer",
          "minimum": 9,
          "maximum": 29
        },
        "tile_width": {
          "const": 512
        },
        "invalid_policy": {
          "const": "nan"
        }
      },
      "required": [
        "hips_path",
        "bunit",
        "linear_unit",
        "scale_state",
        "ordering",
        "leaf_order",
        "tile_width",
        "invalid_policy"
      ]
    },
    "wcs": {
      "$ref": "#/$defs/wcs"
    },
    "photometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "response_calibrated",
            "relative_only",
            "native_unscaled"
          ]
        },
        "response_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "application_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scale_model_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scale_applied": {
          "type": "boolean"
        },
        "parameter_uncertainty": {
          "enum": [
            "modelled",
            "approximate",
            "unmodelled"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "response_id",
        "reference_id",
        "application_id",
        "scale_model_id",
        "scale_applied",
        "parameter_uncertainty",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "native_unscaled"
              }
            }
          },
          "then": {
            "properties": {
              "scale_applied": {
                "const": false
              },
              "application_id": {
                "type": "null"
              },
              "scale_model_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "response_calibrated",
                  "relative_only"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "scale_applied": {
                "const": true
              },
              "application_id": {
                "type": "string",
                "minLength": 1
              },
              "scale_model_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "reference": {
      "$ref": "#/$defs/reference"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "master_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "uncertainty": {
          "enum": [
            "modelled",
            "approximate",
            "unmodelled"
          ]
        },
        "omitted_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "master_ids",
        "uncertainty",
        "omitted_terms"
      ]
    },
    "drizzle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator_model_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pixfrac": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "normalization": {
          "const": "sum_overlap_over_drop_times_source_area"
        },
        "geometry": {
          "enum": [
            "curve_integrated",
            "chord_approximation"
          ]
        },
        "correlation": {
          "enum": [
            "modelled",
            "approximate",
            "unmodelled"
          ]
        }
      },
      "required": [
        "operator_model_id",
        "pixfrac",
        "normalization",
        "geometry",
        "correlation"
      ]
    },
    "precision": {
      "$ref": "#/$defs/precision"
    },
    "source_dimensions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "exposure_seconds": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "exposure_source": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "product_role",
    "run_id",
    "frame_id",
    "input_occurrence",
    "source_sha256",
    "config_sha256",
    "software_sha",
    "signal",
    "wcs",
    "photometry",
    "reference",
    "models",
    "calibration",
    "drizzle",
    "precision",
    "source_dimensions",
    "exposure_seconds",
    "exposure_source"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "accuracy": {
          "enum": [
            "conditional_complete",
            "approximate",
            "upper_bound",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "omitted_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "availability",
        "accuracy",
        "reason",
        "omitted_terms"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "accuracy": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "accuracy": {
                "enum": [
                  "conditional_complete",
                  "approximate",
                  "upper_bound"
                ]
              }
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "psf",
            "covariance",
            "drizzle_operator",
            "support",
            "scale",
            "calibration_uncertainty"
          ]
        },
        "domain": {
          "enum": [
            "calibrated_planar",
            "photo_applied_planar",
            "drizzled_sphere"
          ]
        },
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "required": [
        "model_id",
        "kind",
        "domain",
        "representation",
        "file",
        "status"
      ]
    },
    "sky": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ra_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "dec_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "ra_deg",
        "dec_deg"
      ]
    },
    "sip_term": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "i": {
          "type": "integer",
          "minimum": 0
        },
        "j": {
          "type": "integer",
          "minimum": 0
        },
        "coefficient": {
          "type": "number"
        }
      },
      "required": [
        "i",
        "j",
        "coefficient"
      ]
    },
    "sip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "a": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sip_term"
          }
        },
        "b": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sip_term"
          }
        },
        "ap": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sip_term"
          }
        },
        "bp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sip_term"
          }
        }
      },
      "required": [
        "a",
        "b"
      ]
    },
    "wcs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "solved"
          ]
        },
        "source": {
          "enum": [
            "ipv",
            "explicit_config"
          ]
        },
        "frame": {
          "const": "icrs"
        },
        "projection": {
          "const": "TAN"
        },
        "pixel_origin": {
          "const": "fits_1based"
        },
        "crval_deg": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "crpix": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "cd_deg_per_pixel": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "sip": {
          "anyOf": [
            {
              "$ref": "#/$defs/sip"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogue_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogue_epoch": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "epoch_propagation": {
          "enum": [
            "applied",
            "not_applied",
            "not_applicable"
          ]
        },
        "rms_arcsec": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hint_source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "solved",
                  "unsolved"
                ]
              },
              "reason": {
                "type": "string"
              },
              "n_detections": {
                "type": "integer",
                "minimum": 0
              },
              "n_matches": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "hint_source",
              "status",
              "reason",
              "n_detections",
              "n_matches"
            ]
          }
        }
      },
      "required": [
        "status",
        "source",
        "frame",
        "projection",
        "pixel_origin",
        "crval_deg",
        "crpix",
        "cd_deg_per_pixel",
        "sip",
        "catalogue_id",
        "catalogue_epoch",
        "epoch_propagation",
        "rms_arcsec",
        "attempt_records"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "sed_response",
            "explicit_linear_flux",
            "unavailable"
          ]
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "flux_unit": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "sed_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "response_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference_id",
        "flux_unit",
        "normalization",
        "sed_id",
        "response_id",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sed_response"
              }
            }
          },
          "then": {
            "properties": {
              "reference_id": {
                "type": "string",
                "minLength": 1
              },
              "sed_id": {
                "type": "string",
                "minLength": 1
              },
              "response_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "explicit_linear_flux"
              }
            }
          },
          "then": {
            "properties": {
              "reference_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "surface_variance": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "transfer_factor": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "surface_variance_unit": {
          "type": "string",
          "minLength": 1
        },
        "transfer_unit": {
          "type": "string",
          "minLength": 1
        },
        "covariance_condition": {
          "enum": [
            "reference_source",
            "actual_scene",
            "background_only"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "availability",
        "surface_variance",
        "transfer_factor",
        "surface_variance_unit",
        "transfer_unit",
        "covariance_condition",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "surface_variance": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "transfer_factor": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "surface_variance": {
                "type": "null"
              },
              "transfer_factor": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "sky": {
          "$ref": "#/$defs/sky"
        },
        "source_pixel0": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "leaf_ipix": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "support_id": {
          "type": "string",
          "minLength": 1
        },
        "support_area_sr": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "psf_model_id": {
          "type": "string",
          "minLength": 1
        },
        "covariance_model_id": {
          "type": "string",
          "minLength": 1
        },
        "covariance_condition": {
          "const": "reference_source"
        },
        "background_nuisance": {
          "enum": [
            "known",
            "constant_fit",
            "plane_fit"
          ]
        },
        "reference_flux": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "flux_variance": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_snr": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "covariance_rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "condition_number": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "surface_transfer": {
          "$ref": "#/$defs/transfer"
        },
        "leaf_order": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "control_id",
        "sky",
        "source_pixel0",
        "leaf_ipix",
        "support_id",
        "support_area_sr",
        "psf_model_id",
        "covariance_model_id",
        "covariance_condition",
        "background_nuisance",
        "reference_flux",
        "flux_variance",
        "reference_snr",
        "status",
        "covariance_rank",
        "condition_number",
        "surface_transfer",
        "leaf_order"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "properties": {
                  "availability": {
                    "const": "available"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "reference_flux": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "flux_variance": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "reference_snr": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "properties": {
                  "availability": {
                    "const": "unavailable"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "reference_flux": {
                "type": "null"
              },
              "flux_variance": {
                "type": "null"
              },
              "reference_snr": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
