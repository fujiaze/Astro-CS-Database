{
  "signal_schema": "astrocs.v6.signal/v1",
  "schema_version": 1,
  "physical_quantity": "signal",
  "product_family": "phase1_drizzle_surface_brightness",
  "units": "ADU/sr",
  "pixel_semantics": "surface_brightness",
  "pixel_area_power": -2,
  "formula_ref": "S_p = Sum_j B_j a_jp / Sum_j a_jp, B_j = x_j/A_pixel,j",
  "normalization": {
    "version": "drizzle_sb_normalization_v2_surface_brightness_preserving",
    "kind": "surface_brightness_preserving",
    "pixfrac": 0.8,
    "flux_conservation_factor": 0.64
  },
  "representation": "map",
  "dtype": "float32",
  "invalid_policy": "nan_or_support_le_0",
  "constant_field_oracle": {
    "construction": "x_j = B0 * A_pixel_j (按面亮度 B0 构造)",
    "invariant": "S_p = B0 for all pixfrac in (0,1]",
    "tolerance_ref": "|S_p/B0 - 1| < 1e-3 (沿用, 不自行改容差)"
  },
  "provenance_ref": "provenance/v1/run-1"
}
