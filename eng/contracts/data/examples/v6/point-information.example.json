  "optimality": {
    "claims": ["BLUE", "min_flux_variance"],
    "preconditions_met": { "model_correct": true, "P_normalized": true, "C_representable": true, "gaussian_or_crlb": true, "point_source_target": true }
  },
  "frame_inputs": [
    { "frame_id": "f1", "a_ref": "frame/f1/a", "P_ref": "frame/f1/psf", "C_ref": "frame/f1/covariance" },
    { "frame_id": "f2", "a_ref": "frame/f2/a", "P_ref": "frame/f2/psf", "C_ref": "frame/f2/covariance" }
  ],
  "provenance_ref": "provenance/v1/run-2"
}
