[
  {"type": "git_status", "params": {"repo": "."}},
  {"type": "run_orchestrator", "params": {
    "exe": "git",
    "args": ["log", "--oneline", "-n", "10"],
    "timeout_sec": 30,
    "stdout_file": "engineering_v1.2/evidence/P09-001/git_log_oneline.txt",
    "stderr_file": "engineering_v1.2/evidence/P09-001/git_log_oneline.err"
  }},
  {"type": "run_orchestrator", "params": {
    "exe": "git",
    "args": ["rev-parse", "HEAD", "abbrev-ref", "HEAD", "remote", "get-url", "origin"],
    "timeout_sec": 30,
    "stdout_file": "engineering_v1.2/evidence/P09-001/git_head_info.txt",
    "stderr_file": "engineering_v1.2/evidence/P09-001/git_head_info.err"
  }},
  {"type": "run_orchestrator", "params": {
    "exe": "git",
    "args": ["status", "--porcelain=v1"],
    "timeout_sec": 60,
    "stdout_file": "engineering_v1.2/evidence/P09-001/git_porcelain.txt",
    "stderr_file": "engineering_v1.2/evidence/P09-001/git_porcelain.err"
  }},
  {"type": "run_orchestrator", "params": {
    "exe": "git",
    "args": ["ls-files", "--others", "--exclude-standard", "engineering/"],
    "timeout_sec": 30,
    "stdout_file": "engineering_v1.2/evidence/P09-001/untracked_engineering.txt",
    "stderr_file": "engineering_v1.2/evidence/P09-001/untracked_engineering.err"
  }},
  {"type": "list_dir", "params": {"path": "engineering/evidence", "pattern": "*"}},
  {"type": "list_dir", "params": {"path": "engineering/control", "pattern": "*.csv"}},
  {"type": "sha256", "params": {"path": "engineering/control/PROJECT_STATE.yaml"}},
  {"type": "sha256", "params": {"path": "engineering/control/MASTER_TASK_REGISTER.csv"}},
  {"type": "sha256", "params": {"path": "engineering/control/CURRENT_TASK.md"}}
]
