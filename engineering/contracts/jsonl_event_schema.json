{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrocs.cli.jsonl_event.v1",
  "title": "AstroCS JSONL Event Schema (v1, P04-002)",
  "description": "stdout JSONL event line schema. Each stdout line is one JSON object matching this schema. stderr is reserved for human-readable logs.",
  "type": "object",
  "required": ["schema_version", "type", "job_id", "timestamp"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {
      "enum": [
        "accepted",
        "stage_started",
        "stage_start",
        "stage_completed",
        "stage_end",
        "progress",
        "quality_metric",
        "warning",
        "result",
        "failed",
        "error",
        "cancelled",
        "completed"
      ]
    },
    "job_id": {"type": "string"},
    "timestamp": {"type": "string", "description": "ISO 8601 UTC, e.g. 2026-07-25T10:30:00.123Z"},
    "stage": {"type": "string", "description": "Stage name (READ_FITS/CALIBRATE/PLATESOLVE/PSF/PHOTOMETRIC/SNR/DRIZZLE/GRADIENT_SPHERE/STACK)"},
    "frame": {"type": "string", "description": "Input frame path (stage_start/stage_started)"},
    "duration_ms": {"type": "number", "minimum": 0, "description": "Stage duration in milliseconds (stage_end/stage_completed)"},
    "duration_sec": {"type": "number", "minimum": 0, "description": "Stage duration in seconds (legacy, stage_completed)"},
    "status": {"enum": ["ok", "failed", "degraded"]},
    "progress": {"type": "number", "minimum": 0, "maximum": 1},
    "metric": {"type": "object", "description": "Key metrics (rms_arcsec, n_pairs, snr_phot, etc.)"},
    "rms_arcsec": {"type": "number", "description": "Plate solve RMS in arcsec (PLATESOLVE stage_end)"},
    "n_pairs": {"type": "integer", "minimum": 0, "description": "Plate solve matched pairs (PLATESOLVE stage_end)"},
    "snr_phot": {"type": "number", "description": "Photometric SNR (PHOTOMETRIC stage_end)"},
    "message": {"type": "string"},
    "output": {"type": "string", "description": "Output file path (result event)"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 hash of output (result event)"},
    "effective_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exit_code": {"type": "integer", "minimum": 0, "description": "Numeric exit code (error/failed events), matches process exit code"},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "description": "Stable string error code (ASTROCS_*)"},
        "numeric_code": {"type": "integer", "minimum": 0, "description": "Numeric error code matching exit_code"},
        "message": {"type": "string"},
        "module_code": {},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "result": {"type": "object", "description": "Result payload (success/frame_name/timings/effective_config_hash)"}
  },
  "additionalProperties": false,
  "$defs": {
    "exit_code_mapping": {
      "description": "Numeric exit code to stable name mapping (informational)",
      "0": "SUCCESS",
      "1": "GENERIC_ERROR",
      "2": "DLL_LOAD_FAILED",
      "3": "BLOCK_MISSING",
      "4": "CALIBRATE_FAILED",
      "5": "PLATESOLVE_FAILED",
      "6": "DRIZZLE_FAILED",
      "7": "CONFIG_ERROR",
      "8": "FILE_IO_ERROR",
      "9": "TIMEOUT",
      "10": "CANCELLED",
      "100+": "module-specific"
    }
  }
}
