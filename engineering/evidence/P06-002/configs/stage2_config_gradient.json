{
  "_comment": "P06-002 stage2 配置 - 启用梯度校正 (gaia_data_dir=GaiaDR3SP)",
  "frames_dir": "output/hiss_output/",
  "output_hcsd": "output/stacked.hcsd",
  "stages": [
    "gradient_sphere",
    "stack"
  ],
  "stack": {
    "_comment": "P03-002: 堆叠参数. weighting=snr_squared 在 DLL 内部实现; sigma_clip_max_iter 默认 5",
    "sigma_clip_method": "winsorized",
    "sigma_clip_sigma": 3.0,
    "sigma_clip_max_iter": 5,
    "winsorize_low_pct": 0.05,
    "winsorize_high_pct": 0.95,
    "weighting": "snr_squared",
    "mosaic_fov_ra": 0.0,
    "mosaic_fov_dec": 0.0,
    "mosaic_fov_radius_deg": 0.0
  },
  "gradient_sphere": {
    "_comment": "P06-002: 启用 GaiaDR3SP 星拒绝. orchestrator 用 orc_findJsonKey 字符串搜索, 顶层/嵌套均可",
    "gaia_data_dir": "GaiaDR3SP",
    "gradient_max_iter": 10,
    "gradient_lambda": 1.0e-4
  },
  "log_level": "INFO",
  "threads": 0
}
