{
  "_comment": "P05-002 stage1 config for T2 (4096x4096) frames - LDN43/NGC1727/NGC247",
  "project_root": ".",
  "gaia_data_dir": "GaiaDR3SP",
  "calibration_dir": "testdata/nonexistent_cal_dir_P05_003",
  "output_root": "engineering/evidence/P05-002/hiss",
  "stages": [
    "read_fits",
    "calibrate",
    "platesolve",
    "psf",
    "photometric",
    "snr",
    "drizzle"
  ],
  "frame": {
    "id": "T2_canonical",
    "light_path": "",
    "filter": "",
    "qe_curve": "GSENSE2020BSI"
  },
  "calibration": {
    "_comment": "P03-001: master_*_path 为空时从 calibration_dir + 帧尺寸/曝光/滤镜 自动推导",
    "master_bias_path": "",
    "master_dark_path": "",
    "master_flat_path": "",
    "require_size_match": true,
    "require_exposure_match": true,
    "exposure_tolerance_s": 0.5,
    "require_temperature_match": false,
    "temperature_tolerance_c": 1.0,
    "allow_no_calibration": false,
    "dark_optimization": 0,
    "dark_scale_factor": 1.0
  },
  "platesolve": {
    "_comment": "P03-002: initial_ra/dec 为空时从 FITS header OBJCTRA/DEC 读取",
    "initial_ra": "",
    "initial_dec": "",
    "focal_length": 0.0,
    "pixel_size": 0.0,
    "max_stars": 2000,
    "log_dir": "lib/plate_solve/logs"
  },
  "psf": {
    "_comment": "P03-002: PSF 拟合参数",
    "fit_radius": 8,
    "max_iter": 100,
    "tolerance": 1E-06,
    "max_stars": 2000
  },
  "photometric": {
    "_comment": "P03-002: 测光校准参数 (mag_max 内部自适应迭代)",
    "mag_min": 6.0,
    "mag_max": 16.0,
    "fov_radius_deg": 0.0,
    "filters_json": "lib/photometric_calib/data/response_curves/filters.json",
    "qe_curves_json": "lib/photometric_calib/data/response_curves/qe_curves.json"
  },
  "drizzle": {
    "_comment": "P03-002: Drizzle 参数 (pixfrac=1.0 避免缝隙)",
    "nside_strategy": "1x_to_2x_drizzle",
    "nside_override": 0,
    "pixfrac": 1.0,
    "nested": true
  },
  "log_level": "INFO",
  "threads": 0
}
