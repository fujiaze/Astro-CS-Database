{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrocs.cli.command.v1",
  "type": "object",
  "required": ["schema_version", "command", "job_id", "output"],
  "properties": {
    "schema_version": {"const": 1},
    "command": {"enum": ["stage1", "stage2"]},
    "job_id": {"type": "string", "minLength": 1},
    "input": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "output": {"type": "string", "minLength": 1},
    "project_config": {"type": "string"},
    "overrides": {"type": "object"},
    "timeouts": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}}
  },
  "allOf": [
    {"if": {"properties": {"command": {"const": "stage1"}}}, "then": {"required": ["input"]}},
    {"if": {"properties": {"command": {"const": "stage2"}}}, "then": {"required": ["inputs"]}}
  ],
  "additionalProperties": false
}
