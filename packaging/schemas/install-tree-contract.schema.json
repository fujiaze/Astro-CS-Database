{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrocs://astrocs/packaging/install-tree-contract/v1",
  "title": "AstroCS 模块化安装树布局合同 (BLD-003)",
  "description": "唯一 install 规则源 = 根 CMakeLists.txt include 的 cmake/install_layout.cmake。本 schema 机器校验安装树文件白名单与 ARC-001 dll_units 计划一一对应 (clean install 仅白名单)。打包/安装验证入口 packaging/verify_install_tree.py。",
  "type": "object",
  "required": ["contract_id", "contract_version", "doc_status", "target_version", "root_layout", "units"],
  "properties": {
    "contract_id": { "const": "CONTRACT-BLD003-INSTALL-TREE-V1" },
    "contract_version": { "const": 1 },
    "doc_status": { "const": "ACTIVE_NORMATIVE" },
    "target_version": { "const": "0.11.0-alpha.1" },
    "root_layout": {
      "type": "string",
      "description": "Linux 技术预览前缀相对布局; Windows 正式布局见 03_TARGET_PRODUCT_AND_ARCHITECTURE.md §4 (AstroCS-0.11.0-alpha.1-win-x64/) 由 WIN-* 系列验证"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "kind", "install_path", "required"],
        "properties": {
          "unit_id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "kind": { "type": "string", "enum": ["exe", "runtime", "io", "module", "provider", "schema", "license", "manifest"] },
          "install_path": { "type": "string", "pattern": "^(astrocs|libastrocs_|modules/|providers/|schemas/|licenses/)" },
          "required": { "type": "boolean", "description": "true=验收必须存在 (缺任一 required 文件 → verify FAIL); false=白名单可选 (存在但不额外校验)" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
