{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrocs://astrocs/packaging/dependency-lock/v1",
  "title": "AstroCS 依赖锁合同 (BLD-004)",
  "description": "生产依赖(production_dependencies) 与 test-only oracle(test_only_oracles) 分离锁定; 版本/来源/hash/license; 机器绝对路径与 MSYS2/MinGW 策略; vcpkg 政策 (NOT_USED, 若用必须 manifest+baseline)。机器校验入口 packaging/gen_sbom_input.py (与 DEPENDENCIES.md 一致性 + fresh configure 无机器路径扫描)。",
  "type": "object",
  "required": [
    "lock_schema", "lock_version", "doc_status", "target_version", "owner",
    "policy", "production_dependencies", "system_dependencies",
    "test_only_oracles", "machine_path_scan"
  ],
  "properties": {
    "lock_schema": { "const": "astrocs.dependency-lock/v1" },
    "lock_version": { "const": 1 },
    "doc_status": { "const": "ACTIVE_NORMATIVE" },
    "target_version": { "type": "string" },
    "owner": { "type": "string" },
    "policy": {
      "type": "object",
      "required": ["vcpkg", "msys2_mingw", "machine_absolute_path"],
      "properties": {
        "vcpkg": { "enum": ["NOT_USED", "MANIFEST_BASELINE"] },
        "msys2_mingw": { "enum": ["FORBIDDEN", "DEV_ONLY"] },
        "machine_absolute_path": { "enum": ["FORBIDDEN"] }
      },
      "additionalProperties": true
    },
    "production_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dep_entry" }
    },
    "system_dependencies": { "type": "array", "items": { "$ref": "#/$defs/dep_entry" } },
    "test_only_oracles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dep_entry" }
    },
    "machine_path_scan": { "type": "object" }
  },
  "$defs": {
    "dep_entry": {
      "type": "object",
      "required": ["name", "version", "usage"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "usage": { "type": "string" },
        "vendored_path": { "type": "string" },
        "source": { "type": "string" },
        "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "aggregate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "license": { "type": "string" },
        "policy": { "type": "string" },
        "consumers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
