    "work.second_not_double_reserved",
    "work.upper_gt_budget_rejected",
    "work.first_ok",
    "work.second_readmitted_after_release",
    "work.after_first_at_most_10",
    "work.second_ran_once",
    "work.second_consumed_6",
    "work.total_consumed_10",
    "work.total_within_budget",
    "work.close_command_ok"
  ],
  "min_attempts": 15,
  "expected_success_count": 15,
  "tolerance": "exact work unit counts; error Code compared by name",
  "link": "default",
  "timeout_seconds": 120
}
