{
  "case": "multi01",
  "title": "weighted round robin: weight 1:2 dispatch ratio, no pool/command oversubscription, no starvation",
  "milestone": "M2",
  "contract_refs": [
    "SCHEDULER.md S-MULTI",
    "SCHEDULER.md#多command分配与公平性"
  ],
  "fixed_configuration": {
    "weights": [
      1,
      2
    ],
    "cpu_threads": 1,
    "ready_window": "2P ready + 8P deferred = 10 in flight",
    "rolling_window": 8,
    "sample_dispatches": 120,
    "units_available_per_command": 200,
    "criterion": "2*count1-4 <= count2 <= 2*count1+4 over the first 120 dispatches; both queues stay backlogged; the window cap is a contract, not a relaxation"
  },
  "required_checks": [
    "multi.open_weight1_ok",
    "multi.open_weight2_ok",
    "multi.sample_reached",
    "multi.window_contract_respected",
    "multi.all_units_ok",
    "multi.no_starvation",
    "multi.ratio_1_to_2_complete_rounds",
    "multi.pool_concurrency_within_threads",
    "multi.command_concurrency_within_ceiling",
    "multi.close_weight1_ok",
    "multi.close_weight2_ok"
  ],
  "min_attempts": 11,
  "expected_success_count": 11,
  "tolerance": "empirical: ratio in [1.5,2.5] and |count2-2*count1|<=8; frozen in this manifest",
  "link": "default",
  "timeout_seconds": 180
}
