{
  "version": 1,
  "inputs": {
    "hips": [
      "run/phase1/frame001.hips",
      "run/phase1/frame002.hips"
    ],
    "target_order": "auto"
  },
  "model": {
    "control_grid_per_tile": 8,
    "patch_radius_pixels": "auto",
    "min_samples": 5,
    "snr_search_radius_deg": 0.05,
    "robust_loss": "huber",
    "snr_weight_mode": "snr2_normalized",
    "huber_delta": 1.345,
    "smoothing": "auto",
    "zero_anchor_weight": 0.001,
    "sigma_floor": 0.001,
    "support_power": 1.0
  },
  "integration": {
    "precision": "fp32",
    "memory_limit_mb": 24576,
    "rejection": {
      "method": "auto",
      "profile": "wbpp_current",
      "underdetermined_n": 2,
      "robust_mad_clip": {"lower_sigma": 4.0, "upper_sigma": 3.0, "max_iterations": 8},
      "winsorized_sigma": {"lower_sigma": 4.0, "upper_sigma": 3.0, "max_iterations": 8},
      "averaged_sigma": {"lower_sigma": 4.0, "upper_sigma": 3.0, "max_iterations": 8},
      "linear_fit": {"lower": 4.0, "upper": 3.0, "max_iterations": 8},
      "generalized_esd": {"alpha": 0.05, "max_outliers": 10},
      "percentile": {"low_fraction": 0.1, "high_fraction": 0.1},
      "median_sigma": {"lower_sigma": 4.0, "upper_sigma": 3.0, "max_iterations": 8},
      "minmax": {"reject_low_count": 1, "reject_high_count": 1,
                  "max_iterations": 8, "min_kept": 4},
      "rcr": {"technique": "ss_median_dl"}
    },
    "weight_mode": "auto"
  },
  "output": {
    "hips": "run/phase2/mosaic.hips"
  },
  "diagnostics": {
    "enabled": true
  }
}
