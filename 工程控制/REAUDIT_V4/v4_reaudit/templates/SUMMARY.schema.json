{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "control_version",
    "start_sha",
    "candidate_sha",
    "checkpoint",
    "verdict",
    "task_counts",
    "finding_counts",
    "test_counts",
    "build_counts"
  ],
  "properties": {
    "control_version": {"const": "V3"},
    "start_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checkpoint": {"pattern": "^CP[0-8]$"},
    "verdict": {"enum": ["AWAITING_EXTERNAL_REVIEW", "FAIL", "BLOCKED"]},
    "task_counts": {"type": "object"},
    "finding_counts": {"type": "object"},
    "test_counts": {"type": "object"},
    "build_counts": {"type": "object"}
  },
  "additionalProperties": true
}
