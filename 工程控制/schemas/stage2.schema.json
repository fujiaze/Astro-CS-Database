{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroCS Stage2 production schema (V2)",
  "type": "object",
  "required": [
    "version",
    "inputs",
    "model",
    "integration",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "inputs": {
      "type": "object",
      "required": [
        "hips"
      ],
      "additionalProperties": false,
      "properties": {
        "hips": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_order": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 29
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_grid_per_tile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8
        },
        "patch_radius_pixels": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          ],
          "default": "auto"
        },
        "min_samples": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "snr_search_radius_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.05
        },
        "robust_loss": {
          "const": "huber"
        },
        "snr_weight_mode": {
          "const": "snr2_normalized"
        },
        "huber_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.345
        },
        "smoothing": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "default": "auto"
        },
        "zero_anchor_weight": {
          "type": "number",
          "minimum": 0,
          "default": 0.001
        },
        "sigma_floor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.001
        },
        "support_power": {
          "type": "number",
          "minimum": 0,
          "default": 1.0
        },
        "max_irls_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1e-06
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precision": {
          "enum": [
            "fp32",
            "fp64"
          ],
          "default": "fp32"
        },
        "memory_limit_mb": {
          "type": "integer",
          "minimum": 1,
          "default": 24576
        },
        "rejection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "none",
                "sigma",
                "winsorized_sigma",
                "averaged_sigma",
                "linear_fit",
                "generalized_esd",
                "rcr",
                "percentile",
                "median_sigma",
                "minmax",
                "auto"
              ],
              "default": "auto"
            },
            "profile": {
              "enum": [
                "wbpp_2_9_1",
                "wbpp_current",
                "astrocs_adaptive"
              ],
              "default": "wbpp_2_9_1",
              "description": "wbpp_2_9_1 = 冻结版本（integration-group 层一次解析，WBPP 2.9.1）；wbpp_current = migration alias（解析到 wbpp_2_9_1）；astrocs_adaptive = 按 tile nominal depth 自适应（AstroCS 自有策略）"
            },
            "normalization": {
              "enum": [
                "none",
                "astrocs_median_center_v1",
                "astrocs_median_scale_v1",
                "median_center",
                "median_scale"
              ],
              "default": "astrocs_median_center_v1",
              "description": "V17 RejectionNormalizationPolicy（astrocs_*_v1 为 canonical；median_center/median_scale 为 migration alias）"
            },
            "normalization_floor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1e-12
            },
            "large_scale": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "astrocs.large_scale_rejection.v1 开关（WBPP largeScaleClipLow/High 默认关闭 → 默认 false）"
                },
                "min_structure_pixels": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 8,
                  "description": "8-连通 rejected 分量 >= 该值才算大尺度结构"
                },
                "low_grow_radius_pixels": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 2,
                  "description": "低侧结构扩张半径（Chebyshev 像素）"
                },
                "high_grow_radius_pixels": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 2,
                  "description": "高侧结构扩张半径（Chebyshev 像素）"
                }
              }
            },
            "underdetermined_n": {
              "type": "integer",
              "minimum": 1,
              "default": 2,
              "description": "effective 候选数 <= 该值 → REJECTION_UNDERDETERMINED"
            },
            "robust_mad_clip": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 4.0
                },
                "upper_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 3.0
                },
                "max_iterations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 8
                }
              }
            },
            "winsorized_sigma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 4.0
                },
                "upper_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 3.0
                },
                "max_iterations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 8
                }
              }
            },
            "averaged_sigma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 4.0
                },
                "upper_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 3.0
                },
                "max_iterations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 8
                }
              }
            },
            "linear_fit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 5.0
                },
                "upper": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 3.5
                },
                "max_iterations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 8
                }
              }
            },
            "generalized_esd": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "alpha": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1,
                  "default": 0.05
                },
                "max_outliers": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 10
                }
              }
            },
            "percentile": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "low_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.2
                },
                "high_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.1
                }
              }
            },
            "median_sigma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 4.0
                },
                "upper_sigma": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 3.0
                },
                "max_iterations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 8
                }
              }
            },
            "minmax": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reject_low_count": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "reject_high_count": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "min_kept": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 4
                }
              }
            },
            "rcr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "technique": {
                  "const": "ss_median_dl"
                }
              }
            }
          },
          "required": [
            "method"
          ]
        },
        "weight_mode": {
          "description": "R5 冻结：auto=support_x_snr2（synthetic truth bias 0.0002 最优）；equal 仅诊断；其余 R5 比较策略未生产暴露",
          "enum": [
            "auto",
            "equal",
            "support_x_snr2"
          ],
          "default": "auto"
        },
        "acr_route": {
          "enum": [
            "auto",
            "cpu"
          ],
          "default": "auto",
          "description": "auto=可用则 CUDA（仅 Sigma）；cpu=强制 CPU legacy（R9 等价证据）"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "hips"
      ],
      "additionalProperties": false,
      "properties": {
        "hips": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostics": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "default": 0,
          "description": "CPU worker 数, 0=auto(max(1,hardware_concurrency))"
        },
        "io_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "default": 0,
          "description": "IO worker 数, 0=auto(cpu/2,min1)"
        },
        "gpu_route": {
          "enum": [
            "cpu",
            "auto",
            "cuda"
          ],
          "default": "auto",
          "description": "GPU 路由"
        },
        "deterministic": {
          "type": "boolean",
          "default": true,
          "description": "固定 seed/顺序/归并(可复现)"
        },
        "memory_budget_bytes": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "内存预算字节, 0=由 memory_limit_mb 决定"
        }
      }
    }
  }
}