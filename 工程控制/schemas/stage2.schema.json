{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroCS Stage2 production schema (V2)",
  "type": "object",
  "required": [
    "version",
    "inputs",
    "model",
    "integration",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "inputs": {
      "type": "object",
      "required": [
        "hips"
      ],
      "additionalProperties": false,
      "properties": {
        "hips": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_order": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 29
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_grid_per_tile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8
        },
        "patch_radius_pixels": {
          "oneOf": [
            { "const": "auto" },
            { "type": "integer", "minimum": 0, "maximum": 64 }
          ],
          "default": "auto"
        },
        "min_samples": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "snr_search_radius_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.05
        },
        "robust_loss": {
          "const": "huber"
        },
        "snr_weight_mode": {
          "const": "snr2_normalized"
        },
        "huber_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.345
        },
        "smoothing": {
          "oneOf": [
            { "const": "auto" },
            { "type": "number", "minimum": 0 }
          ],
          "default": "auto"
        },
        "zero_anchor_weight": {
          "type": "number",
          "minimum": 0,
          "default": 0.001
        },
        "sigma_floor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.001
        },
        "support_power": {
          "type": "number",
          "minimum": 0,
          "default": 1.0
        },
        "max_irls_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1e-6
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precision": {
          "enum": ["fp32", "fp64"],
          "default": "fp32"
        },
        "memory_limit_mb": {
          "type": "integer",
          "minimum": 1,
          "default": 24576
        },
        "rejection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "none", "sigma", "winsorized_sigma", "averaged_sigma",
                "linear_fit", "generalized_esd", "rcr"
              ]
            },
            "low": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 4.0
            },
            "high": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 3.0
            },
            "max_iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 8
            },
            "min_samples": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            }
          },
          "required": ["method"]
        },
        "weight_mode": {
          "description": "R5 冻结：auto=support_x_snr2（synthetic truth bias 0.0002 最优）；equal 仅诊断；其余 R5 比较策略未生产暴露",
          "enum": [
            "auto", "equal", "support_x_snr2"
          ],
          "default": "auto"
        },
        "acr_route": {
          "enum": ["auto", "cpu"],
          "default": "auto",
          "description": "auto=可用则 CUDA（仅 Sigma）；cpu=强制 CPU legacy（R9 等价证据）"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "hips"
      ],
      "additionalProperties": false,
      "properties": {
        "hips": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostics": {
      "type": "object"
    }
  }
}
