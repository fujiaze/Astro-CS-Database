{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroCS Stage2 production schema (V2)",
  "type": "object",
  "required": [
    "version",
    "inputs",
    "model",
    "integration",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "inputs": {
      "type": "object",
      "required": [
        "hips"
      ],
      "additionalProperties": false,
      "properties": {
        "hips": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_order": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 29
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_grid_per_tile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8
        },
        "patch_radius_pixels": {
          "oneOf": [
            { "const": "auto" },
            { "type": "integer", "minimum": 0, "maximum": 64 }
          ],
          "default": "auto"
        },
        "min_samples": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "snr_search_radius_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.05
        },
        "robust_loss": {
          "const": "huber"
        },
        "snr_weight_mode": {
          "const": "snr2_normalized"
        },
        "huber_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.345
        },
        "smoothing": {
          "oneOf": [
            { "const": "auto" },
            { "type": "number", "minimum": 0 }
          ],
          "default": "auto"
        },
        "zero_anchor_weight": {
          "type": "number",
          "minimum": 0,
          "default": 0.001
        },
        "sigma_floor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.001
        },
        "support_power": {
          "type": "number",
          "minimum": 0,
          "default": 1.0
        },
        "max_irls_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1e-6
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precision": {
          "enum": ["fp32", "fp64"],
          "default": "fp32"
        },
        "memory_limit_mb": {
          "type": "integer",
          "minimum": 1,
          "default": 24576
        },
        "rejection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "none", "sigma", "winsorized_sigma", "averaged_sigma",
                "linear_fit", "generalized_esd", "rcr", "percentile",
                "median_sigma", "minmax", "auto"
              ],
              "default": "auto"
            },
            "profile": {
              "enum": ["wbpp_current"],
              "default": "wbpp_current",
              "description": "WBPP Auto routing 政策（本机 WBPP 2.9.1 源码核准）"
            },
            "underdetermined_n": {
              "type": "integer",
              "minimum": 1,
              "default": 2,
              "description": "effective 候选数 <= 该值 → REJECTION_UNDERDETERMINED"
            },
            "robust_mad_clip": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 4.0},
                "upper_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 3.0},
                "max_iterations": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
              }
            },
            "winsorized_sigma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 4.0},
                "upper_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 3.0},
                "max_iterations": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
              }
            },
            "averaged_sigma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 4.0},
                "upper_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 3.0},
                "max_iterations": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
              }
            },
            "linear_fit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower": {"type": "number", "exclusiveMinimum": 0, "default": 4.0},
                "upper": {"type": "number", "exclusiveMinimum": 0, "default": 3.0},
                "max_iterations": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
              }
            },
            "generalized_esd": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.05},
                "max_outliers": {"type": "integer", "minimum": 1, "maximum": 64, "default": 10}
              }
            },
            "percentile": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "low_fraction": {"type": "number", "minimum": 0, "default": 0.1},
                "high_fraction": {"type": "number", "minimum": 0, "default": 0.1}
              }
            },
            "median_sigma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 4.0},
                "upper_sigma": {"type": "number", "exclusiveMinimum": 0, "default": 3.0},
                "max_iterations": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8}
              }
            },
            "minmax": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reject_low_count": {"type": "integer", "minimum": 1, "default": 1},
                "reject_high_count": {"type": "integer", "minimum": 1, "default": 1},
                "max_iterations": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8},
                "min_kept": {"type": "integer", "minimum": 1, "default": 4}
              }
            },
            "rcr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "technique": {"const": "ss_median_dl"}
              }
            },
            "low": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 4.0,
              "description": "DEPRECATED（V15）：改用 method-specific typed 参数"
            },
            "high": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 3.0,
              "description": "DEPRECATED（V15）"
            },
            "max_iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 8,
              "description": "DEPRECATED（V15）"
            },
            "min_samples": {
              "type": "integer",
              "minimum": 1,
              "default": 2,
              "description": "DEPRECATED（V15）：语义由 underdetermined_n 承担"
            }
          },
          "required": ["method"]
        },
        "weight_mode": {
          "description": "R5 冻结：auto=support_x_snr2（synthetic truth bias 0.0002 最优）；equal 仅诊断；其余 R5 比较策略未生产暴露",
          "enum": [
            "auto", "equal", "support_x_snr2"
          ],
          "default": "auto"
        },
        "acr_route": {
          "enum": ["auto", "cpu"],
          "default": "auto",
          "description": "auto=可用则 CUDA（仅 Sigma）；cpu=强制 CPU legacy（R9 等价证据）"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "hips"
      ],
      "additionalProperties": false,
      "properties": {
        "hips": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostics": {
      "type": "object"
    }
  }
}
