{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "frame",
    "success",
    "n_pairs",
    "median_px",
    "p90_px",
    "p99_px",
    "x_bias_px",
    "y_bias_px"
  ],
  "properties": {
    "frame": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    },
    "n_pairs": {
      "type": "integer",
      "minimum": 0
    },
    "median_px": {
      "type": "number"
    },
    "p90_px": {
      "type": "number"
    },
    "p99_px": {
      "type": "number"
    },
    "x_bias_px": {
      "type": "number"
    },
    "y_bias_px": {
      "type": "number"
    },
    "quadrant_stats": {
      "type": "object"
    },
    "sip_enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
