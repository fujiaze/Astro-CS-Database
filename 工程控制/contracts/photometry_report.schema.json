{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "frame",
    "valid_fsyn",
    "gaia_in_frame",
    "psf_valid",
    "unique_matches",
    "fit_used",
    "scale_factor",
    "sigma_residual",
    "status"
  ],
  "properties": {
    "frame": {
      "type": "string"
    },
    "valid_fsyn": {
      "type": "integer"
    },
    "gaia_in_frame": {
      "type": "integer"
    },
    "psf_valid": {
      "type": "integer"
    },
    "unique_matches": {
      "type": "integer"
    },
    "fit_used": {
      "type": "integer"
    },
    "scale_factor": {
      "type": [
        "number",
        "null"
      ]
    },
    "sigma_residual": {
      "type": [
        "number",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIPPED"
      ]
    },
    "match_distance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
