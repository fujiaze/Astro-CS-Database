{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroCS WCS Authoritative Pair Report",
  "type": "object",
  "required": [
    "schema_version",
    "frame_id",
    "solver_rms_px",
    "pairs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "frame_id": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string"
    },
    "solver_version": {
      "type": "string"
    },
    "detection_hash": {
      "type": "string"
    },
    "solver_rms_px": {
      "type": "number"
    },
    "n_inliers": {
      "type": "integer",
      "minimum": 1
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pair_id",
          "gaia_ra_deg",
          "gaia_dec_deg",
          "detector_x_px",
          "detector_y_px"
        ],
        "properties": {
          "pair_id": {
            "type": "integer"
          },
          "gaia_source_id": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "gaia_ra_deg": {
            "type": "number"
          },
          "gaia_dec_deg": {
            "type": "number"
          },
          "detector_x_px": {
            "type": "number"
          },
          "detector_y_px": {
            "type": "number"
          },
          "internal_pred_x_px": {
            "type": [
              "number",
              "null"
            ]
          },
          "internal_pred_y_px": {
            "type": [
              "number",
              "null"
            ]
          },
          "internal_residual_px": {
            "type": [
              "number",
              "null"
            ]
          },
          "saturated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "edge": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "blend": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "求解溯源元数据（P11-006 新增）",
      "properties": {
        "solver_version": {
          "type": "string",
          "description": "求解器版本，如 ipv_v4.30"
        },
        "solver_commit": {
          "type": "string",
          "description": "求解器 git commit hash"
        },
        "gaia_catalog_version": {
          "type": "string",
          "description": "Gaia 星表版本，如 DR3SP"
        },
        "detection_hash": {
          "type": "string",
          "description": "检测结果哈希（sha256 前16位）"
        },
        "observation_epoch": {
          "type": "string",
          "description": "观测历元，从 FITS header 提取"
        },
        "wcs_closure_summary": {
          "type": "object",
          "description": "WCS 闭环验证摘要",
          "properties": {
            "layer_a_solver_rms_px": {
              "type": "number"
            },
            "layer_b_external_p68_px": {
              "type": "number"
            },
            "layer_b_external_p90_px": {
              "type": "number"
            },
            "layer_b_external_p99_px": {
              "type": "number"
            },
            "gate_passed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "software_commit_config_hash": {
          "type": "string",
          "description": "软件 commit+config 哈希"
        }
      },
      "required": [
        "solver_version",
        "gaia_catalog_version"
      ],
      "additionalProperties": false
    }
  }
}
