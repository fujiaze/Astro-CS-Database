{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "branch",
    "base_commit",
    "result_commit",
    "working_tree_clean",
    "generated_at",
    "artifacts",
    "tests",
    "source_snapshot_commit",
    "git_log_tip",
    "path_guard"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "const": "feature/astrocompute-runtime"
    },
    "base_commit": {
      "type": "string",
      "minLength": 7
    },
    "result_commit": {
      "type": "string",
      "minLength": 7
    },
    "merge_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "working_tree_clean": {
      "const": true
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "log"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED"
            ]
          },
          "log": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "source_snapshot_commit": {
      "type": "string",
      "minLength": 7
    },
    "git_log_tip": {
      "type": "string",
      "minLength": 7
    },
    "path_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code",
        "log"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "exit_code": {
          "const": 0
        },
        "log": {
          "type": "string"
        }
      }
    }
  }
}
