+            proc = H.run_runner(["--profile", "fast", "--output-root", str(out_root)], repo)
+            self.assertEqual(proc.returncode, 0, proc.stderr)
+            per = H.load_check_result(out_root, "CHK-CLEAN")
+            self.assertEqual(per["verdict"], "PASS")
