{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HISS v2 minimum metadata",
  "type": "object",
  "required": [
    "format_version",
    "nside",
    "ordering",
    "filter",
    "signal",
    "support",
    "snr_model",
    "provenance"
  ],
  "properties": {
    "format_version": {
      "type": "string"
    },
    "nside": {
      "type": "integer",
      "minimum": 1
    },
    "ordering": {
      "enum": [
        "NESTED",
        "RING"
      ]
    },
    "filter": {
      "type": "string"
    },
    "signal": {
      "type": "object",
      "required": [
        "dtype",
        "count",
        "block_index"
      ]
    },
    "support": {
      "type": "object",
      "required": [
        "dtype",
        "count"
      ]
    },
    "snr_model": {
      "type": "object",
      "required": [
        "point_count",
        "model_type"
      ]
    },
    "provenance": {
      "type": "object"
    }
  }
}
