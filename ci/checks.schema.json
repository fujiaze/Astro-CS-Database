{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profiles",
          "platform",
          "command",
          "timeout_seconds",
          "heavy",
          "mutates_workspace",
          "outputs",
          "waivable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_.-]+$"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "fast",
                "linux-main",
                "linux-deep",
                "windows-main",
                "fatduck"
              ]
            }
          },
          "platform": {
            "enum": [
              "any",
              "linux",
              "windows",
              "fatduck"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "heavy": {
            "type": "boolean"
          },
          "mutates_workspace": {
            "type": "boolean"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "waivable": {
            "type": "boolean"
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_monitor": {
            "type": "boolean"
          },
          "prerequisite_tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "可选：命令依赖的外部工具名（如 cmake/clang/pytest），缺失时检查跳过（waivable）或 FAIL(prerequisite)"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
