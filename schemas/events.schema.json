{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "run_id",
    "seq",
    "event",
    "code",
    "assessment",
    "completed",
    "total",
    "message"
  ],
  "properties": {
    "protocol": {
      "const": "acsd.events/2"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "enum": [
        "run_started",
        "frame_started",
        "block_progress",
        "frame_finished",
        "product_published",
        "issue",
        "run_finished"
      ]
    },
    "frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "block": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "code": {
      "type": "string"
    },
    "assessment": {
      "type": [
        "object",
        "null"
      ]
    },
    "completed": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "summary": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "run_finished"
          }
        }
      },
      "then": {
        "required": [
          "exit_code",
          "summary"
        ]
      }
    }
  ]
}
